%% ------------------------------------------------------------
%% 4. さくいん  \bkidx{よみ（ひらがな）}{語}
%%   ページ番号はページを組んだとき（shipout）に決まる。1回前の組版の結果を読んで並べる。
%% ------------------------------------------------------------
\directlua{
  bk = bk or {}
  bk.idx = {}
  function bk.loadidx(fn)
    local f = io.open(fn, 'r'); if not f then return end
    for line in f:lines() do
      local y, w, p = line:match('^(.-)|(.*)|(\@percentchar d+)$')
      if y then table.insert(bk.idx, {y = y, w = w, p = tonumber(p)}) end
    end
    f:close()
  end
  local voiced = {}
  local pairs_ = {'がか','ぎき','ぐく','げけ','ごこ','ざさ','じし','ずす','ぜせ','ぞそ','だた','ぢち','づつ','でて','どと',
    'ばは','びひ','ぶふ','べへ','ぼほ','ぱは','ぴひ','ぷふ','ぺへ','ぽほ','ぁあ','ぃい','ぅう','ぇえ','ぉお','ゃや','ゅゆ','ょよ','っつ'}
  for _, s in ipairs(pairs_) do
    local cs = {}; for _, c in utf8.codes(s) do cs[rawlen(cs) + 1] = c end
    voiced[cs[1]] = cs[2]
  end
  % のばす音「ー」は、前の字の母音として並べる（めーとる → めえとる）
  local vowel = {}
  local vrows = {'あかさたなはまやらわがざだばぱぁゃ', 'いきしちにひみりぎじぢびぴぃ', 'うくすつぬふむゆるぐずづぶぷぅゅっ', 'えけせてねへめれげぜでべぺぇ', 'おこそとのほもよろをごぞどぼぽぉょ'}
  local vchar = {0x3042, 0x3044, 0x3046, 0x3048, 0x304A}
  for i, r in ipairs(vrows) do for _, c in utf8.codes(r) do vowel[c] = vchar[i] end end
  local function key(y)
    local out = {}
    local prev = nil
    for _, c in utf8.codes(y) do
      if c >= 0x30A1 and c <= 0x30F6 then c = c - 0x60 end
      if c == 0x30FC and prev and vowel[prev] then c = vowel[prev] end
      prev = c
      c = voiced[c] or c
      out[rawlen(out) + 1] = utf8.char(c)
    end
    return table.concat(out)
  end
  local rows = {{'あ','あいうえお'},{'か','かきくけこ'},{'さ','さしすせそ'},{'た','たちつてと'},{'な','なにぬねの'},
    {'は','はひふへほ'},{'ま','まみむめも'},{'や','やゆよ'},{'ら','らりるれろ'},{'わ','わをん'}}
  local function rowof(k)
    local c = utf8.codepoint(k, 1)
    for _, r in ipairs(rows) do
      for _, d in utf8.codes(r[2]) do if d == c then return r[1] end end
    end
    return '記号・英字'
  end
  function bk.printidx()
    local merged, order = {}, {}
    for _, e in ipairs(bk.idx) do
      local id = e.y .. '|' .. e.w
      if not merged[id] then merged[id] = {y = e.y, w = e.w, k = key(e.y), ps = {}}; table.insert(order, merged[id]) end
      merged[id].ps[e.p] = true
    end
    table.sort(order, function(a, b)
      local ra, rb = rowof(a.k) == '記号・英字', rowof(b.k) == '記号・英字'
      if ra ~= rb then return ra end
      if a.k ~= b.k then return a.k < b.k end
      return a.y < b.y end)
    local cur = nil
    for _, e in ipairs(order) do
      local r = rowof(e.k)
      if r ~= cur then tex.sprint('\string\\bkidxgroup{' .. r .. '}'); cur = r end
      local ps = {}
      for p, _ in pairs(e.ps) do table.insert(ps, p) end
      table.sort(ps)
      local s = {}
      for i, p in ipairs(ps) do s[i] = tostring(p) end
      tex.sprint('\string\\bkidxline{' .. e.w .. '}{' .. table.concat(s, ', ') .. '}')
    end
  end
}
\newwrite\bk@idxout
\AtBeginDocument{%
  \directlua{bk.loadidx('\jobname.bkidx')}%
  \immediate\openout\bk@idxout=\jobname.bkidx}
\newcommand\bkidx[2]{\write\bk@idxout{\unexpanded{#1}|\unexpanded{#2}|\thepage}}
\newcommand\bkidxgroup[1]{\par\addvspace{6pt}\noindent
  {\sffamily\bfseries\small\color{bkDeep}#1}\par\nobreak\vspace{1pt}{\color{bkVol}\hrule height 0.6pt}\nobreak\vspace{3pt}}
\newcommand\bkidxline[2]{\par\noindent\hangindent=1em\hangafter=1 {\ltjsetruby{mode=9}#1}\dotfill{\sffamily #2}\par}% mode=9: 行頭のルビのはみ出しで項目の頭が右へずれないように（第12回）

