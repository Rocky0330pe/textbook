% 巻末の見出し  \bkbacktitle{見出し}
\newcommand\bkbacktitle[1]{%
  \clearpage\global\bk@decotrue\bkfolio{true}%
  \colorlet{bkTheme}{bkVol}%
  \bksetrunning{}{#1}{#1}\gdef\bk@tabpos{0}%
  % 第7回：見出しにルビ（\R）があっても、しおりと BKPAGE の名前は親字だけにする
  {\def\R##1##2{##1}\pdfbookmark[0]{#1}{bkback-#1}\typeout{BKPAGE back #1 \thepage}}%
  \noindent{\sffamily\bfseries\fontsize{24}{30}\selectfont\color{bkDeep}#1}\par\vspace{1mm}
  {\color{bkVol}\hrule height 1.4pt}\vspace{4mm}}
% こたえ
\newcommand\bkAnswerPages{%
  \bkbacktitle{こたえ}%
  {\small 「じぶんでとこう」は\,\tikz[baseline=(c.base)]\node[draw=bkOrange, text=bkOrange!80!black, rounded corners=0.8mm,
      inner xsep=0.8mm, inner ysep=0.3mm, font=\sffamily\bfseries\scriptsize] (c) {じ1};\,、\R{章末問題}{しょう|まつ|もん|だい}は\,\tikz[baseline=(c.base)]\node[fill=bkTheme, text=bkOn, rounded corners=0.8mm, minimum width=1.3em,
      inner xsep=0.5mm, inner ysep=0.3mm, font=\sffamily\bfseries\scriptsize] (c) {1};\,のように\R{番号}{ばん|ごう}をつけています。とき\R{方}{かた}は、\R{同}{おな}じ\R{形}{かたち}の\R{例題}{れい|だい}にもどって\R{確}{たし}かめよう。\par}
  \vspace{3mm}
  \begin{multicols}{2}\footnotesize\setlength{\parskip}{1pt}\raggedright
  \ifnum\bkvol>1\relax\bk@anseqbreak\fi
  \bk@ansbuf
  \end{multicols}}
% 第6回：こたえのページでは、長い式を「＝」の前で折り返す（行末に「＝」を残さず、次の行を「＝」から始める）。
% 数式の中の「＝」だけを、改行してよい印（\penalty）＋もとの「＝」に置きかえる（第2巻から）
\newcommand\bk@anseqbreak{\Umathcharnumdef\bk@eqchar=\Umathcodenum`\=\relax\mathcode`\=="8000\relax}
\begingroup\lccode`\~=`\=\lowercase{\endgroup\def~}{\penalty50 \bk@eqchar}
% 記号カードの一覧
\newcommand\bkkigorow[4]{#1 & #2 & #3 & #4 \\}
%% longtblr の見出し・つづきの文字を日本語にする（英語の Continued などを出さない）
\DefTblrTemplate{caption}{bk}{}
\DefTblrTemplate{capcont}{bk}{}
\DefTblrTemplate{contfoot-text}{bk}{\footnotesize\sffamily\color{bkGray}つぎのページへつづく}
\DefTblrTemplate{conthead-text}{bk}{}
\SetTblrTemplate{caption}{bk}
\SetTblrTemplate{capcont}{bk}
\SetTblrTemplate{contfoot-text}{bk}
\SetTblrTemplate{conthead-text}{bk}
\newcommand\bkKigoPages[1]{% #1 = 前の巻の記号の行（\bkkigorow…）
  \bkbacktitle{\R{記号}{き|ごう}カード}%
  {\small この\R{巻}{かん}で\R{出}{で}てきた\R{記号}{き|ごう}と、この\R{巻}{かん}でよく\R{使}{つか}う\R{前}{まえ}の\R{巻}{かん}の\R{記号}{き|ごう}です。}\par\vspace{3mm}
  \begingroup
  \def\bkkigorow##1##2##3##4{\unexpanded{##1 & ##2 & ##3 & ##4 \\}}%
  \edef\bk@kigobody{#1\bk@kigobuf}%
  \footnotesize
  \begin{longtblr}[expand=\bk@kigobody]{colspec={Q[c,m,wd=18mm] Q[l,m,wd=37mm] Q[l,m,wd=55mm] Q[c,m,wd=12mm]}, rowhead=1,
    row{1}={bg=bkVol!14, font=\sffamily\bfseries}, rowsep=1.2pt, hlines={0.4pt,bkLine}}
  \R{記号}{き|ごう} & \R{読}{よ}み\R{方}{かた} & \R{意味}{い|み} & \R{章}{しょう} \\
  \bk@kigobody
  \end{longtblr}
  \endgroup}

%% ------------------------------------------------------------
%% 7. 表計算の画面  \bksheet{列の数}{列幅（mm）}{行 \\ 行 \\ …}
%%    1行目に列の名前（A, B, C…）をつける。各行のはじめに行番号を書く（例：1 & t & x \\）
%% ------------------------------------------------------------
\NewDocumentCommand\bksheet{m m +m}{%
  \def\bk@colsp{Q[c,m,wd=5mm,bg=bkLine!45,font=\sffamily\scriptsize]}%
  \def\bk@sw{#2}\def\bk@sn{#1}\@tempcnta=0\relax
  \loop\advance\@tempcnta\@ne\edef\bk@colsp{\unexpanded\expandafter{\bk@colsp} Q[r,m,wd=\bk@sw mm]}\ifnum\@tempcnta<\bk@sn\repeat
  \edef\bk@sheetspec{colspec={\unexpanded\expandafter{\bk@colsp}}, rowsep=0.6pt, colsep=1.6mm, vlines={0.4pt,bkLine}, hlines={0.4pt,bkLine},
    row{1}={bg=bkLine!45, font=\noexpand\sffamily\noexpand\scriptsize, halign=c}, cells={font=\noexpand\sffamily\noexpand\footnotesize}}%
  \edef\bk@sheethead{\ifcase#1\or & A\or & A & B\or & A & B & C\or & A & B & C & D\or & A & B & C & D & E\or & A & B & C & D & E & F\or & A & B & C & D & E & F & G\fi}%
  \expandafter\bk@sheet\expandafter{\bk@sheetspec}{#3}}
\newcommand\bk@sheet[2]{\expandafter\bk@sheetb\expandafter{\bk@sheethead}{#1}{#2}}
\newcommand\bk@sheetb[3]{\begin{tblr}{#2}#1\\#3\end{tblr}}

%% ------------------------------------------------------------
%% 8. グラフ（pgfplots）の共通スタイル
%% ------------------------------------------------------------
% 第7回：「axis on top」の層の組では格子が線や面の上に出てしまうので、格子を main（線・面）の下、
% 軸・目もり・目もり数字を main の上に置く層の組 bk を作って使う
\pgfplotsset{/pgfplots/layers/bk/.define layer set={axis background,axis grid,pre main,main,axis ticks,axis lines,axis tick labels,axis descriptions,axis foreground}{/pgfplots/layers/standard}}
\pgfplotsset{
  bkplot/.style={axis lines=middle, axis line style={-{Stealth[length=5pt]}, line width=0.8pt, bkInk},
    % 第6回：目もりの数字の上を格子の線や色の面が通らないように、数字のうしろを白くうすく敷く
    tick label style={font=\sffamily\footnotesize, text=bkInk}, label style={font=\sffamily\small, text=bkInk},
    every axis x label/.style={at={(ticklabel* cs:1)}, anchor=west, xshift=1mm, font=\sffamily\small, text=bkInk},
    every axis y label/.style={at={(ticklabel* cs:1)}, anchor=south, yshift=1mm, font=\sffamily\small, text=bkInk},
    % 第6回・第7回：軸・目もり数字は面や線の上に出し、格子の線だけは線や面のうしろに置く（層の組 bk）
    set layers=bk, grid=major, grid style={bkLine, line width=0.3pt}, major tick length=2pt,
    every axis plot/.append style={line width=1.6pt}, samples=100, clip=false,
    enlargelimits=false, scaled ticks=false,
    % 第7回：目もりの数字に千の位のカンマをつけない（本文・表と同じ書き方）
    /pgf/number format/1000 sep={}},
  bkcurve/.style={bkBlue, line width=1.7pt},
  bkcurve2/.style={bkOrange, line width=1.7pt},
  bkcurve3/.style={bkGreen, line width=1.7pt},
  bkthin/.style={bkGray, line width=0.9pt},
}

%% ------------------------------------------------------------
%% 9. 序章は \bkchapter{巻}{0}{題名}{★}{柱} で書く（番号の丸に「序章」と出る）
%% ------------------------------------------------------------
%% 10. 数式でよく使う書き方
%% ------------------------------------------------------------
\newcommand\dd{\mathrm{d}}
\newcommand\diff[2]{\frac{\dd #1}{\dd #2}}
\newcommand\difft[2]{\frac{\dd^2 #1}{\dd #2^2}}
\newcommand\eval[3]{\Bigl[\,#1\,\Bigr]_{#2}^{#3}}
\newcommand\bkbig[1]{\par\addvspace{3pt}\noindent\hfill{\large$\displaystyle #1$}\hfill\null\par\addvspace{3pt}}

% 仮の章（ページ数だけ確保する）
\newcommand\bkstubpages[1]{\par\vspace{1cm}\noindent{\Large（仮）}\par
  \@tempcnta=1\relax\loop\ifnum\@tempcnta<#1\relax\clearpage\null\advance\@tempcnta\@ne\repeat\clearpage}
\makeatother
