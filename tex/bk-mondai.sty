  \noindent{\interlinepenalty=10000\makebox[2.2em][l]{\small(#1)}%
  \begin{minipage}[t]{\dimexpr\linewidth-2.2em-\wd\mq@figbox-4mm\relax}\mqragged #2\end{minipage}\hfill
  \raisebox{\dimexpr1.2\ht\strutbox-\ht\mq@figbox\relax}{\usebox\mq@figbox}}\par\vspace{1.4mm}\fi}
