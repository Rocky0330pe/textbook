% \mqmiwake{部の番号}{部の名前}  見開きの頭
\newcommand\mqspreadhead[4]{% {部の番号}{部の名前}{見出し}{説明}
  \clearpage\ifodd\value{page}\mqmemopage\fi\typeout{MQSPREAD \thepage}%
  \bksetrunning{#1}{\R{問題集}{もん|だい|しゅう}\hspace{0.5em}\R{第}{だい}\bkvol\R{巻}{かん}\hspace{0.8em}\R{第}{だい}#1\R{部}{ぶ}\hspace{0.5em}#2}{#3}%
  \gdef\bk@tabpos{#1}%
  \noindent\begin{tikzpicture}[x=1mm, y=1mm]
    \path[use as bounding box] (0,-1) rectangle (\linewidth,15);
    \node[anchor=west, fill=bkDeep, text=white, rounded corners=3mm, font=\sffamily\bfseries\large,
      inner xsep=3mm, inner ysep=1.8mm] (n) at (0,7) {#3};
    \node[anchor=west, font=\sffamily\bfseries, text=bkDeep] at ([xshift=4mm]n.east) {\R{第}{だい}#1\R{部}{ぶ}\hspace{0.4em}#2};
    \draw[bkDeep, line width=1.2pt] (0,-0.5) -- (\linewidth,-0.5);
  \end{tikzpicture}\par\vspace{2mm}\noindent #4\par\vspace{2mm}}
% 見分けようの問題：答えの欄のあとに「わざ」を書く欄
\newcommand\mqwazabox{\hspace{0.6em}{\footnotesize わざ}\hspace{0.2em}\mqbox[13mm]}

