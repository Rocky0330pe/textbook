\newsavebox\mq@runb
\newcommand\mq@runfit[1]{\sbox\mq@runb{#1}\ifdim\wd\mq@runb>120mm\resizebox{120mm}{!}{\usebox\mq@runb}\else\usebox\mq@runb\fi}
\newcommand\mqcompare[2]{%
  \ifnum\bkvol>3 \global\advance\mq@cmpn 1 \edef\mq@cmpgroup{mqcmp\the\mq@cmpn}\fi
