% 見出しの言葉（第1巻はひらがな・分かち書き、第2巻からは教科書と同じく漢字にルビ）
\newcommand\mqT[1]{\csname mqT@#1\endcsname}
\ifnum\bkvol=1\relax
  \def\mqT@mark{\R{見}{み}わける めじるし}\def\mqT@futsu{ふつうに とくと}\def\mqT@raku{らくな かたちに すると}
  \def\mqT@why{どうして らくに なるの？}\def\mqT@caution{つかえない とき}\def\mqT@trapnote{らくに ならない もんだいだよ。 どうしてかな？}
  \def\mqT@mon{もん}\def\mqT@memo{けいさんの メモ}\def\mqT@partwaza{この ぶの わざ}
\else
  \def\mqT@mark{\R{見分}{み|わ}ける\R{目印}{め|じるし}}\def\mqT@futsu{ふつうに\R{解}{と}くと}\def\mqT@raku{\R{楽}{らく}な\R{形}{かたち}にすると}
  \def\mqT@why{どうして\R{楽}{らく}になるの？}\def\mqT@caution{\R{使}{つか}えないとき}\def\mqT@trapnote{\R{楽}{らく}にならない\R{問題}{もん|だい}です。どうしてかな？}
  \def\mqT@mon{\R{問}{もん}}\def\mqT@memo{\R{計算}{けい|さん}メモ}\def\mqT@partwaza{この\R{部}{ぶ}のわざ}
\fi
