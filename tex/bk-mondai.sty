\newcommand\mqfig[1]{\par\nopagebreak\vspace{1mm}\hspace*{2.2em}#1\par}
% 図のある問題（第35回。組 d の要望）：1列のときは、文を左、図を右にならべる（縦の場所をとらない）。せまい列では文の下に置く
\newsavebox\mq@figbox
\newcommand\mqpf[3]{\par\sbox\mq@figbox{#3}%
