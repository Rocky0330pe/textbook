\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bk-mondai}[2026/11/06 v0.1 workbook parts]
\RequirePackage{xparse}

%% ------------------------------------------------------------
%% 1. 小さな部品
%% ------------------------------------------------------------
% 書きこむ所（答えの欄）。\mqbox[はば]
\newcommand\mqbox[1][\mq@boxw]{\tikz[baseline=-0.9ex]\draw[bkTheme, line width=0.9pt, rounded corners=1mm, fill=white] (0,-3.4mm) rectangle (#1,4.4mm);}
\def\mq@boxw{15mm}
% 分数（第1巻は教科書と同じ \dfrac）
\newcommand\mqfrac[2]{$\dfrac{#1}{#2}$}
% わざの札（丸い札）\mqwazachip{1-37}
\newcommand\mqwazachip[1]{\tikz[baseline=(c.base)]\node[fill=bkTheme, text=white, rounded corners=2.4mm,
  font=\sffamily\bfseries\small, inner xsep=2.4mm, inner ysep=1.2mm] (c) {わざ\hspace{0.25em}#1};}
\newcommand\mqwazachipsmall[1]{\tikz[baseline=(c.base)]\node[draw=bkTheme, text=bkDeep, rounded corners=1.6mm, line width=0.7pt,
  font=\sffamily\bfseries\footnotesize, inner xsep=1.4mm, inner ysep=0.6mm] (c) {#1};}
% 教科書の札
\newcommand\mqtextbook[1]{\tikz[baseline=(c.base)]\node[draw=bkGray, text=bkGray, rounded corners=1.2mm, line width=0.6pt,
  font=\sffamily\footnotesize, inner xsep=1.2mm, inner ysep=0.5mm] (c) {\R{教科書}{きょう|か|しょ}\hspace{0.2em}#1};}
% ★（数学シリーズの★の物差し）
\newcommand\mqstars[1]{{\color{bkOrange}\ifnum#1>1 ★★\else ★\fi}}

%% ------------------------------------------------------------
%% 2. わざの見開き
%% ------------------------------------------------------------
% \mqwaza{番号}{わざの名前}{教科書の章}{★}{部の番号}{部の名前}
%   左ページ（偶数）から始める。左右のページは \mqrightpage で分ける。
\newcommand\mqpartname{}
\newcommand\mqwaza[6]{%
  \clearpage\ifodd\value{page}\mqmemopage\fi
  \bksetrunning{#5}{\R{問題集}{もん|だい|しゅう}\hspace{0.5em}\R{第}{だい}\bkvol\R{巻}{かん}\hspace{0.8em}\R{第}{だい}#5\R{部}{ぶ}\hspace{0.5em}#6}{わざ\hspace{0.3em}#1\hspace{0.6em}#2}%
  \gdef\bk@tabpos{#5}%
  \phantomsection\label{mq:#1}\typeout{MQPAGE #1 \thepage}%
  \pdfbookmark[1]{わざ #1}{mqwaza#1}%
  \noindent\begin{tikzpicture}[x=1mm, y=1mm]
    \path[use as bounding box] (0,-1) rectangle (\linewidth,13);
    \node[anchor=west, fill=bkTheme, text=white, rounded corners=3mm, font=\sffamily\bfseries\large,
      inner xsep=3mm, inner ysep=1.6mm] (n) at (0,6) {わざ\hspace{0.3em}#1};
    \node[anchor=west, text width=\dimexpr\linewidth-33mm\relax, font=\bfseries, align=left, inner sep=0pt] at ([xshift=3mm]n.east) {#2\hspace{0.6em}\mbox{\mdseries\mqtextbook{#3}\hspace{0.3em}{\footnotesize\mqstars{#4}}}};
    \draw[bkTheme, line width=1.2pt] (0,-0.5) -- (\linewidth,-0.5);
  \end{tikzpicture}\par\nobreak\vspace{1.2mm}%
}
% 見分ける目印
\newcommand\mqmark[1]{\par\noindent
  \begin{tcolorbox}[enhanced, colback=bkTheme!6, colframe=bkTheme, boxrule=1pt, arc=2mm, left=1.5mm, right=2mm, top=0.5mm, bottom=0.5mm, before skip=0pt, after skip=0pt]
  \tikz[baseline=(c.base)]\node[fill=bkTheme, text=white, rounded corners=1.2mm, font=\sffamily\bfseries\footnotesize, inner xsep=1.5mm, inner ysep=0.6mm] (c) {\R{見}{み}わける めじるし};\hspace{0.5em}#1\end{tcolorbox}\par}
% ふつうの解き方と、楽な解き方を並べる  \mqcompare{ふつう}{らく}
\newcommand\mqcompare[2]{%
  \par\vspace{1.2mm}\noindent{\small
  \begin{tcolorbox}[enhanced, width=0.42\linewidth, nobeforeafter, box align=top, colback=white, colframe=bkGray!70, boxrule=0.8pt, arc=2mm,
    left=1.5mm, right=1.5mm, top=0.5mm, bottom=1mm, fonttitle=\sffamily\bfseries\small, coltitle=bkGray, colbacktitle=bkGray!12,
    title={ふつうに とくと}, equal height group=mqcmp]
  #1\end{tcolorbox}\hfill
  \raisebox{-10mm}{\tikz\fill[bkTheme] (0,0) -- (4mm,2.5mm) -- (0,5mm) -- cycle;}\hfill
  \begin{tcolorbox}[enhanced, width=0.52\linewidth, nobeforeafter, box align=top, colback=bkTheme!5, colframe=bkTheme, boxrule=1.2pt, arc=2mm,
    left=1.5mm, right=1.5mm, top=0.5mm, bottom=1mm, fonttitle=\sffamily\bfseries\small, coltitle=white, colbacktitle=bkTheme,
    title={らくな かたちに すると}, equal height group=mqcmp]
  #2\end{tcolorbox}}\par\vspace{1mm}}
% なぜ楽になるか・使えないとき
\newcommand\mqwhy[1]{\par\noindent{\small{\sffamily\bfseries\small\color{bkDeep}どうして らくに なるの？}\hspace{0.5em}#1\par}}
\newcommand\mqcaution[1]{\par\noindent{\small{\sffamily\bfseries\small\color{bkOrange}\tikz[baseline=-0.6ex]{\fill[bkOrange] (0,-1.6mm) -- (3.6mm,-1.6mm) -- (1.8mm,1.6mm) -- cycle; \node[white, font=\bfseries\tiny] at (1.8mm,-0.5mm) {!};}\hspace{0.3em}つかえない とき}\hspace{0.5em}#1\par}}
% ステップの見出し  \mqstep{s1}{見出しの文}
\newcommand\mqstep[2]{\par\addvspace{1.8mm}\Needspace{3\baselineskip}\noindent
  \tikz[baseline=(c.base)]\node[fill=\ifx\relax#1\relax bkTheme\else bkTheme\fi, text=white, rounded corners=1.5mm, font=\sffamily\bfseries\small,
    inner xsep=2mm, inner ysep=0.8mm] (c) {#2};\par\nobreak\vspace{0.6mm}}
\newcommand\mqtrapstep[1]{\par\addvspace{2.5mm}\Needspace{3\baselineskip}\noindent
  \tikz[baseline=(c.base)]\node[fill=bkOrange, text=white, rounded corners=1.5mm, font=\sffamily\bfseries\small,
    inner xsep=2mm, inner ysep=0.8mm] (c) {#1};\hspace{0.6em}{\small らくに ならない もんだいも まざって いるよ}\par\nobreak\vspace{0.6mm}}
% 問題のならび  \begin{mqprobs}{列の数} \mqp{番号}{問題} ... \end{mqprobs}
\newenvironment{mqprobs}[1]{\par\noindent\setlength{\tabcolsep}{0pt}\def\mq@cols{#1}%
  \setlength{\columnsep}{6mm}\ifnum#1>1 \begin{multicols}{#1}\fi\raggedright}{\ifnum\mq@cols>1 \end{multicols}\fi\par}
\newcommand\mqp[2]{\par\noindent{\interlinepenalty=10000\hangindent=2.2em\hangafter=1\makebox[2.2em][l]{\small(#1)}#2\par}\vspace{1.4mm}}
% 右ページへ
\newcommand\mqrightpage{\clearpage\typeout{MQRIGHT \thepage}}
% ふりかえり
\newcommand\mqfurikaeri[3]{\par\vfill\noindent
  \begin{tcolorbox}[enhanced, colback=white, colframe=bkLine, boxrule=0.8pt, arc=2mm, left=2mm, right=2mm, top=1mm, bottom=1mm]
  {\sffamily\bfseries\small ふりかえり}\hspace{1em}{\small
  \tikz\draw[bkTheme, line width=0.8pt] (0,0) rectangle (3.4mm,3.4mm);\ ステップ1（#1\R{問}{もん}）\hspace{0.8em}%
  \tikz\draw[bkTheme, line width=0.8pt] (0,0) rectangle (3.4mm,3.4mm);\ ステップ2（#2\R{問}{もん}）\hspace{0.8em}%
  \tikz\draw[bkTheme, line width=0.8pt] (0,0) rectangle (3.4mm,3.4mm);\ ステップ3（#3\R{問}{もん}）}
  \end{tcolorbox}\par}
% 白いページ（けいさんの メモ）。見開きの頭をそろえるときだけ使う
\newcommand\mqmemopage{\bksetrunning{}{}{}\null\vfill
  \noindent\begin{tikzpicture}[x=1mm,y=1mm]
    \node[anchor=north west, font=\sffamily\bfseries\small, text=bkGray] at (0,190) {けいさんの メモ};
    \foreach \i in {1,...,18} \draw[bkLine, line width=0.4pt, dash pattern=on 1.5pt off 2pt] (0,190-\i*10) -- (\linewidth,190-\i*10);
  \end{tikzpicture}\vfill\clearpage}

