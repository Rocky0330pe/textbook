\newcommand\mqanshead[2]{\par\addvspace{2.2mm}\Needspace{3\baselineskip}\noindent\mqwazachip{#1}\hspace{0.5em}{\small\bfseries #2}\hspace{0.5em}{\footnotesize\color{bkGray}（\pageref{mq:#1}ページ）}\par\nobreak\vspace{0.4mm}}
\newcommand\mqanssub[1]{\par\noindent{\footnotesize\sffamily\bfseries\color{bkDeep}#1}\par\nobreak}
\newcommand\mqa[3]{% {番号}{答え}{楽な形}。楽な形の中では改行してよい
