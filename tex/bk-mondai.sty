% \mqwaza{番号}{わざの名前}{教科書の章}{★}{部の番号}{部の名前}
%   左ページ（偶数）から始める。左右のページは \mqrightpage で分ける。
\newcommand\mqpartname{}
\newsavebox\mq@chipbox
\newcommand\mqwaza[6]{%
  \clearpage\ifodd\value{page}\mqmemopage\fi
  \bksetrunning{#5}{\R{問題集}{もん|だい|しゅう}\hspace{0.5em}\R{第}{だい}\bkvol\R{巻}{かん}\hspace{0.8em}\R{第}{だい}#5\R{部}{ぶ}\hspace{0.5em}#6}{\mq@runfit{わざ\hspace{0.3em}#1\hspace{0.6em}#2}}%
  \gdef\bk@tabpos{#5}%
  \phantomsection\label{mq:#1}\typeout{MQPAGE #1 \thepage}%
  \pdfbookmark[1]{わざ #1}{mqwaza#1}%
  % 番号の札のあとに名前。2行になるときは、札の右から書く（第29回：字の間を広げない）
  \sbox\mq@chipbox{\tikz[baseline=(n.base)]\node[fill=bkTheme, text=white, rounded corners=3mm, font=\sffamily\bfseries\large,
      inner xsep=3mm, inner ysep=1.6mm] (n) {わざ\hspace{0.3em}#1};}%
  {\noindent\hangindent=\dimexpr\wd\mq@chipbox+3mm\relax\hangafter=1\rightskip=0pt plus 1fil\relax\parfillskip=0pt plus 1fil\relax
   \usebox\mq@chipbox\hspace{3mm}{\bfseries #2}\hspace{0.6em}\mbox{\mqtextbook{#3}\hspace{0.3em}{\footnotesize\mqstars{#4}}}\par}%
  \nobreak\nointerlineskip\vspace{1.4mm}\noindent{\color{bkTheme}\rule{\linewidth}{1.2pt}}\par\nobreak\nointerlineskip\vspace{1.2mm}%
}
% 見分ける目印
\newcommand\mqmark[1]{\par\noindent
  \begin{tcolorbox}[enhanced, colback=bkTheme!6, colframe=bkTheme, boxrule=1pt, arc=2mm, left=1.5mm, right=2mm, top=0.5mm, bottom=0.5mm, before skip=0pt, after skip=0pt]
  \tikz[baseline=(c.base)]\node[fill=bkTheme, text=white, rounded corners=1.2mm, font=\sffamily\bfseries\footnotesize, inner xsep=1.5mm, inner ysep=0.6mm] (c) {\mqT{mark}};\hspace{0.5em}#1\end{tcolorbox}\par}
% ふつうの解き方と、楽な解き方を並べる  \mqcompare{ふつう}{らく}
% 囲みの高さをそろえる組：第3巻までは本全体で1つ。第4巻からは、わざごと（本全体でそろえると、いちばん高い囲みに合わせて見開きがあふれる。第35回）
\newcount\mq@cmpn
\def\mq@cmpgroup{mqcmp}
