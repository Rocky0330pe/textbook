%%    どの巻の色も、白い字とのコントラスト 4.5:1 以上（組んだ画像で測った値）
%% ------------------------------------------------------------
\definecolor{phVol1}{cmyk}{1,0.60,0,0.10}       % 群青（力学）      白 6.9:1
\definecolor{phVol2}{cmyk}{0,0.85,0.95,0.18}    % 朱赤（熱学）      白 5.3:1
\definecolor{phVol3}{cmyk}{0.88,0.05,0.50,0.30} % 青緑（波動）      白 4.9:1
\definecolor{phVol4}{cmyk}{0.05,0.45,1,0.35}    % 金茶（電磁気学）  白 4.8:1
\definecolor{phVol5}{cmyk}{0.65,0.85,0,0.10}    % 紫（原子）        白 8.7:1
\colorlet{phOn1}{white}\colorlet{phOn2}{white}\colorlet{phOn3}{white}\colorlet{phOn4}{white}\colorlet{phOn5}{white}
\colorlet{phDeep1}{phVol1!85!black}\colorlet{phDeep2}{phVol2!90!black}\colorlet{phDeep3}{phVol3!90!black}
\colorlet{phDeep4}{phVol4!85!black}\colorlet{phDeep5}{phVol5!90!black}
\definecolor{phInk}{cmyk}{0.75,0.65,0.45,0.70}  % シリーズ共通の墨の帯（数学シリーズとの見分け）
\definecolor{phHook}{cmyk}{0,0,0,0.78}           % もくじの「なぜ？」の字（白に 8:1）
