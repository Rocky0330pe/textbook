}
% 全5巻の帯  \ph@lineup{x}{y}
\newcommand\ph@lineup[2]{%
  \foreach \i/\t in {1/力学, 2/熱学, 3/波動, 4/電磁気学, 5/原子} {
    \pgfmathsetmacro\ph@lx{#1+(\i-1)*30.5}
    \ifnum\i=\phvol\relax
      \fill[phVol\i] (\ph@lx,#2-4) rectangle ++(28,22);
      \fill[phVol\i] (\ph@lx+14-2.6,#2+17.6) -- ++(5.2,0) -- ++(-2.6,3.4) -- cycle;
      \node[anchor=base, text=phOn\i, font=\sffamily\bfseries\fontsize{16}{16}\selectfont] at (\ph@lx+14,#2+6.6) {\i};
      \node[anchor=base, text=phOn\i, font=\sffamily\bfseries\fontsize{9.5}{10}\selectfont] at (\ph@lx+14,#2-0.8) {\t};
    \else
      \fill[phVol\i] (\ph@lx,#2) rectangle ++(28,14);
      \node[anchor=base, text=phOn\i, font=\sffamily\bfseries\fontsize{11}{11}\selectfont] at (\ph@lx+14,#2+6.6) {\i};
      \node[anchor=base, text=phOn\i, font=\sffamily\bfseries\fontsize{9}{10}\selectfont] at (\ph@lx+14,#2+1.7) {\t};
    \fi
  }}
