%% ------------------------------------------------------------
%% 3. 4つの顔のピクトグラム（動く・回る・ゆがむ・流れる）
%%    \phfaceat{(x,y)}{大きさ}{番号}{色}{線の太さ}
%%      たて・よこ −1〜1 の枠に描く。矢じりと角の丸みも大きさに合わせて縮む。
%%    \phfacesmat{(x,y)}{大きさ}{番号}{色}{線の太さ}
%%      直径10 mm 以下の丸に入れるときの、形をへらした絵（指摘 No.3）
%% ------------------------------------------------------------
\tikzset{ph arrow/.style={-{Stealth[length=0.26*\ph@u, width=0.25*\ph@u]}},
  ph arrow sm/.style={-{Stealth[length=0.48*\ph@u, width=0.52*\ph@u]}}}
\def\ph@u{1cm}
\newcommand\ph@face@i[2]{% 動く：走る車と、速度の矢印
  \fill[#1, rounded corners=0.10*\ph@u] (-0.98,-0.28) rectangle (0.24,0.06);
  \fill[#1, rounded corners=0.06*\ph@u] (-0.76,0.04) -- (-0.58,0.34) -- (-0.10,0.34) -- (0.08,0.04) -- cycle;
  \fill[#1] (-0.66,-0.31) circle (0.16) (-0.04,-0.31) circle (0.16);
  \draw[#1, line width=0.6*#2, line cap=round] (-1.0,-0.52) -- (1.0,-0.52);
  \draw[#1, line width=#2, line cap=round, ph arrow] (0.38,-0.11) -- (0.98,-0.11);}
\newcommand\ph@face@ii[2]{% 回る：はずみ車と、回る向きの矢印（右へ進む車の車輪と同じ、時計回り）
  \draw[#1, line width=#2] (0,0) circle (0.44);
  \fill[#1] (0,0) circle (0.10);
  \foreach \a in {0,60,...,300} \draw[#1, line width=0.8*#2] (\a:0.10) -- (\a:0.44);
  \draw[#1, line width=#2, line cap=round, ph arrow] (155:0.66) arc (155:28:0.66);
  \draw[#1, line width=#2, line cap=round, ph arrow] (335:0.66) arc (335:208:0.66);}
\newcommand\ph@face@iii[2]{% ゆがむ：左を回転支点、右を移動支点で支えたはりが、まん中の力でたわむ
  \draw[#1, line width=0.55*#2, dash pattern=on 0.05*\ph@u off 0.05*\ph@u] (-0.85,0.05) -- (0.85,0.05);
  \draw[#1, line width=1.6*#2, line cap=round] (-0.85,0.05) .. controls (-0.30,-0.32) and (0.30,-0.32) .. (0.85,0.05);
  % 回転支点：三角と、斜線をつけた地面
  \fill[#1] (-0.85,0.02) -- (-0.69,-0.24) -- (-1.01,-0.24) -- cycle;
  \draw[#1, line width=0.6*#2] (-1.07,-0.26) -- (-0.63,-0.26);
  \foreach \x in {-1.03,-0.91,-0.79,-0.67} \draw[#1, line width=0.45*#2] (\x+0.04,-0.26) -- (\x-0.03,-0.36);
  % 移動支点：三角と、ころ、地面
  \fill[#1] (0.85,0.02) -- (1.01,-0.20) -- (0.69,-0.20) -- cycle;
  \fill[#1] (0.76,-0.255) circle (0.045) (0.94,-0.255) circle (0.045);
  \draw[#1, line width=0.6*#2] (0.63,-0.31) -- (1.07,-0.31);
  \draw[#1, line width=#2, line cap=round, ph arrow] (0,0.80) -- (0,-0.19);}
\newcommand\ph@face@iv[2]{% 流れる：細くなる管の中で、流れが速くなる（のどの矢印が長い）
  \draw[#1, line width=1.3*#2, line join=round] (-1.0,0.56) -- (-0.40,0.56) -- (-0.12,0.24) -- (0.12,0.24) -- (0.40,0.56) -- (1.0,0.56);
  \draw[#1, line width=1.3*#2, line join=round] (-1.0,-0.56) -- (-0.40,-0.56) -- (-0.12,-0.24) -- (0.12,-0.24) -- (0.40,-0.56) -- (1.0,-0.56);
  \draw[#1, line width=0.45*#2] (-1.0,0.30) -- (-0.42,0.30) .. controls (-0.22,0.30) and (-0.20,0.12) .. (0,0.12)
    .. controls (0.20,0.12) and (0.22,0.30) .. (0.42,0.30) -- (1.0,0.30);
  \draw[#1, line width=0.45*#2] (-1.0,-0.30) -- (-0.42,-0.30) .. controls (-0.22,-0.30) and (-0.20,-0.12) .. (0,-0.12)
    .. controls (0.20,-0.12) and (0.22,-0.30) .. (0.42,-0.30) -- (1.0,-0.30);
  \draw[#1, line width=0.9*#2, line cap=round, ph arrow] (-0.95,0) -- (-0.66,0);
  \draw[#1, line width=0.9*#2, line cap=round, ph arrow] (-0.33,0) -- (0.35,0);
  \draw[#1, line width=0.9*#2, line cap=round, ph arrow] (0.64,0) -- (0.95,0);}
% 小さな丸に入れる形（線を太く、部品を少なく、矢じりを大きく）
\newcommand\ph@facesm@i[2]{% 動く：小さな車と、長い矢印
  \fill[#1, rounded corners=0.07*\ph@u] (-0.98,-0.24) rectangle (-0.12,0.06);
  \fill[#1, rounded corners=0.05*\ph@u] (-0.84,0.04) -- (-0.70,0.30) -- (-0.36,0.30) -- (-0.24,0.04) -- cycle;
  \fill[#1] (-0.76,-0.27) circle (0.14) (-0.34,-0.27) circle (0.14);
  \draw[#1, line width=#2, line cap=round, ph arrow sm] (0.04,-0.06) -- (0.98,-0.06);}
\newcommand\ph@facesm@ii[2]{% 回る：時計回りの矢印
  \fill[#1] (0,0) circle (0.17);
  \draw[#1, line width=#2, line cap=butt, ph arrow sm] (110:0.66) arc (110:-200:0.66);}
\newcommand\ph@facesm@iii[2]{% ゆがむ
  \draw[#1, line width=1.2*#2, line cap=round] (-0.80,0.0) .. controls (-0.28,-0.36) and (0.28,-0.36) .. (0.80,0.0);
  \fill[#1] (-0.80,-0.04) -- (-0.60,-0.40) -- (-1.0,-0.40) -- cycle;
  \fill[#1] (0.80,-0.04) -- (1.0,-0.40) -- (0.60,-0.40) -- cycle;
  \draw[#1, line width=#2, line cap=butt, ph arrow sm] (0,0.90) -- (0,-0.18);}
\newcommand\ph@facesm@iv[2]{% 流れる
  \draw[#1, line width=#2, line join=round] (-0.95,0.54) -- (-0.36,0.54) -- (-0.10,0.26) -- (0.10,0.26) -- (0.36,0.54) -- (0.95,0.54);
  \draw[#1, line width=#2, line join=round] (-0.95,-0.54) -- (-0.36,-0.54) -- (-0.10,-0.26) -- (0.10,-0.26) -- (0.36,-0.54) -- (0.95,-0.54);
  \draw[#1, line width=#2, line cap=butt, ph arrow sm] (-0.70,0) -- (0.72,0);}
% 第1巻の絵の名前を巻の番号つきにする（第2〜5巻の絵は bk-phys-faces.tex）
\expandafter\let\csname ph@face@1@i\endcsname\ph@face@i
\expandafter\let\csname ph@face@1@ii\endcsname\ph@face@ii
\expandafter\let\csname ph@face@1@iii\endcsname\ph@face@iii
\expandafter\let\csname ph@face@1@iv\endcsname\ph@face@iv
\expandafter\let\csname ph@facesm@1@i\endcsname\ph@facesm@i
\expandafter\let\csname ph@facesm@1@ii\endcsname\ph@facesm@ii
\expandafter\let\csname ph@facesm@1@iii\endcsname\ph@facesm@iii
\expandafter\let\csname ph@facesm@1@iv\endcsname\ph@facesm@iv
\input{bk-phys-faces.tex}
\newcommand\phfaceat[5]{\begin{scope}[shift={#1}, x=#2, y=#2]\def\ph@u{#2}%
  \csname ph@face@\phvol @\romannumeral#3\endcsname{#4}{#5}\end{scope}}
\newcommand\phfacesmat[5]{\begin{scope}[shift={#1}, x=#2, y=#2]\def\ph@u{#2}%
  \csname ph@facesm@\phvol @\romannumeral#3\endcsname{#4}{#5}\end{scope}}
% 文中に置く丸いアイコン  \phfaceicon[直径]{番号}（形をへらした絵。丸の内側に 1.5 mm 以上の余白）
\newcommand\phfaceicon[2][7mm]{\tikz[baseline=-0.38em]{\fill[bkVol] (0,0) circle (#1/2);
  \phfacesmat{(0,0)}{#1*0.31}{#2}{white}{0.06*#1}}}

%% ------------------------------------------------------------
%% 4. 小さな部品：使う数学の巻の札・★・方眼
%% ------------------------------------------------------------
% \phmathchip[大きさ]{巻}  数学シリーズの巻の色の四角に巻の番号
\newcommand\phmathchip[2][4.2mm]{\tikz[baseline=-0.36em]\node[fill=bkVol#2, text=phChipOn#2, rounded corners=0.6mm, minimum width=#1,
  minimum height=#1, inner sep=0pt, font=\sffamily\bfseries\fontsize{8.5}{9}\selectfont] {#2};}
% ★のメーター（指摘 No.4）：最小まで ★（塗り）、最大まで ☆（白ぬき）、その先は うすい★。白黒でも形で見分けられる
\newcommand\phstarmeter[2]{{\sffamily\scriptsize\@tempcnta=0\relax
  \loop\advance\@tempcnta\@ne
    \ifnum\@tempcnta>#2\relax\textcolor{bkLine}{★}%
    \else\ifnum\@tempcnta>#1\relax\textcolor{bkStar}{☆}%
    \else\textcolor{bkStar}{★}\fi\fi
  \ifnum\@tempcnta<5\repeat}}
% 「なぜ？」のアイコン
\newcommand\phhatena[1][1em]{\bkicon[#1]{hatena}{phHatena}}
% 方眼（設計図の紙）  \ph@grid{x0}{y0}{x1}{y1}
\newcommand\ph@grid[4]{%
  \begin{scope}\clip (#1,#2) rectangle (#3,#4);
    \draw[white, opacity=0.10, line width=0.25pt, step=5] (#1-10,#2-10) grid (#3+10,#4+10);
    \draw[white, opacity=0.22, line width=0.45pt, step=25] (#1-25,#2-25) grid (#3+25,#4+25);
  \end{scope}}

