\newcommand\ph@tocmeta[4]{% 数学の巻（カンマ区切り、空もよい）, ★最小, ★最大, ページ
  \begin{tikzpicture}[baseline=-0.38em, x=1mm, y=1mm]
    \path[use as bounding box] (0,-1) rectangle (42,1);
    \node[anchor=east, inner sep=0pt, text=bkInk, font=\sffamily\bfseries\fontsize{11}{12}\selectfont] (pg) at (42,0) {\bkpageno{#4}};
    \node[anchor=east, inner sep=0pt] (st) at (29,0) {\phstarmeter{#2}{#3}};
    \def\ph@mv{#1}%
    \ifx\ph@mv\@empty\else
      \foreach \m [count=\k] in {#1} {\xdef\ph@nm{\k}}%
      \foreach \m [count=\k] in {#1} {
        \node[anchor=east, inner sep=0pt] at ([xshift={-2mm-(\ph@nm-\k)*4.8mm}]st.west) {\phmathchip{\m}};}
    \fi
  \end{tikzpicture}}
% 章の行  \phtocchap{番号}{題名}{なぜ？}{数学の巻}{★最小}{★最大}{ページ}{種類}
\newcommand\phtocchap[8]{%
  \par\noindent
  \parbox[t]{14mm}{\leavevmode\raisebox{0.3mm}{\bk@tocpill{#1}{#8}}}%
  \parbox[t]{\dimexpr\linewidth-14mm-42mm\relax}{\setlength\parskip{0pt}%
    \leavevmode{\ph@tocTitle\color{bkInk}#2\def\bk@k{#8}\def\bk@R{R}\ifx\bk@k\bk@R\hspace{0.5em}{\fontsize{8.5}{9}\selectfont\color{bkDeep}［読みもの］}\fi}}%
  \parbox[t]{42mm}{\leavevmode{\ph@tocTitle\ph@tocmeta{#4}{#5}{#6}{#7}}}%
  \par\nobreak\vspace{-1.3mm}\noindent\hspace{14mm}%
  \parbox[t]{\dimexpr\linewidth-14mm\relax}{\setlength\parskip{0pt}%
    \leavevmode{\ph@tocHook\color{phHook}\phhatena[0.95em]\hspace{0.35em}#3}}%
  \par\nobreak\vspace{\dimexpr\ph@tocgap+1.3mm\relax}{\color{bkLine}\hrule height 0.35pt}\vspace{\ph@tocgap}}
\newcommand\phtocbreak{\par\clearpage}
