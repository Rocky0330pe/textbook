% 本文の部品（柱・つめ・ノンブル・帯）も物理の巻の色にする
\colorlet{bkVol}{phVol\phvol}\colorlet{bkOn}{phOn\phvol}\colorlet{bkDeep}{phDeep\phvol}
\colorlet{bkTheme}{bkVol}
\foreach \i in {0,...,8} {\global\colorlet{bkPart\i}{bkVol}}\global\colorlet{bkPartA}{bkVol}
% 使う数学の巻の札の字の色：第1〜7巻の色は明るいので濃い字、第8・9巻は白い字（どれも 4.4:1 以上）
