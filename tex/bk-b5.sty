}

%% ------------------------------------------------------------
%% 12. 道しるべ（章の帯のすぐ下）  \bkmichishirube{前に読む章}{この章の先}
%%   章番号の札は、その章がある巻の色でぬる（ほかの巻の章もひと目でわかる）
%% ------------------------------------------------------------
\def\bk@getvol#1-#2\relax{#1}
\newcommand\bk@pill[1]{\edef\bk@pv{\expandafter\bk@getvol#1\relax}%
  \tikz[baseline=(p.base)]\node[fill=bkVol\bk@pv, text=bkOn\bk@pv, rounded corners=1mm, inner xsep=1.6mm, inner ysep=0.8mm,
    font=\sffamily\bfseries\fontsize{8}{9}\selectfont] (p) {#1};}
\newcommand\bk@pills[1]{\foreach \bk@c [count=\bk@k] in {#1}{\ifnum\bk@k>1\hspace{0.3em}\fi\expandafter\bk@pill\expandafter{\bk@c}}}
\newcommand\bk@signicon{\tikz[baseline=-0.6ex, x=1em, y=1em]{\fill[bkTheme] (0,0) circle (0.55);
  \draw[white, line width=0.9pt] (0,-0.38)--(0,0.4); \fill[white] (-0.32,0.12)--(0.28,0.12)--(0.4,0.24)--(0.28,0.36)--(-0.32,0.36)--cycle;}}
\newcommand\bkmichishirube[2]{%
  \par\vspace{1mm}{\sffamily\fontsize{8.5}{12}\selectfont\color{bkGray}%
  \setbox0\hbox{\bk@signicon\hspace{0.4em}{\bfseries\R{道}{みち}しるべ}\hspace{1.2em}}%
  \hangindent=\wd0 \hangafter=1 \rightskip=0pt plus 1fil\noindent% 第13回：2行めに折り返したら「道しるべ」の右にそろえ、「この章の先に」をひとまとまりで送る
  \bk@signicon\hspace{0.4em}{\bfseries\color{bkDeep}\R{道}{みち}しるべ}\hspace{1.2em}%
  \if\relax\detokenize{#1}\relax\else この\R{章}{しょう}の\R{前}{まえ}に\hspace{0.5em}\bk@pills{#1}\hspace{1.5em}\penalty0 \fi% 第5回：前に読む章がなければ出さない
  \mbox{この\R{章}{しょう}の\R{先}{さき}に\hspace{0.5em}\bk@pills{#2}}\par}
  \vspace{1.5mm}{\color{bkLine}\hrule height 0.5pt}\vspace{3mm}}

\endinput
