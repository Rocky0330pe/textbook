%% ------------------------------------------------------------
%% 2. ルビ  \R{漢字}{かん|じ}
%%   読みの区切り「|」の数が字数と同じ → 1字ずつ（熟語ルビ）
%%   違う（今日{きょう} など）→ まとめてルビ（グループルビ）
%% ------------------------------------------------------------
\ltjsetruby{size=0.5, stretch=101}
\directlua{
  bk = bk or {}
  local cct = luatexbase.registernumber('catcodetable@latex')
  function bk.ruby()
    local base = token.scan_argument(false)
    local reading = token.scan_argument(false)
    local _, bars = reading:gsub('|', '|')
    local chars = {}
    for _, c in utf8.codes(base) do chars[\string#chars + 1] = utf8.char(c) end
    local b = base
    local groups, long = {}, false
    for g in (reading .. '|'):gmatch('([^|]*)|') do
      groups[\string#groups + 1] = g
      if utf8.len(g) > 2 then long = true end
    end
    if bars > 0 and bars + 1 == \string#chars and not long then
      % 1字ずつ（モノルビ）
      b = table.concat(chars, '|')
    else
      % 読みが親字からはみ出す熟語は、まとめてルビ（グループルビ）にして字間のすき間を防ぐ
      reading = reading:gsub('|', '')
    end
    tex.sprint(cct, '\\ruby{' .. b .. '}{' .. reading .. '}')
  end
}
\protected\def\R{\directlua{bk.ruby()}}
%% 第4巻以降は総ルビにしない（親字だけを出す。使う漢字は常用漢字＝中学までの範囲）
