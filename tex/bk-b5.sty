\tikzset{
  bk axis/.style={-{Stealth[length=6pt]}, line width=0.9pt, bkInk},
  bk grid/.style={bkLine, line width=0.4pt},
  bk tick/.style={font=\sffamily\small, text=bkInk},
  bk label/.style={font=\sffamily\small, text=bkInk},
  bk data/.style={line width=1.8pt, bkBlue},
  bk area/.style={fill=bkBlue!18},
  bk note/.style={font=\sffamily\small, text=bkGray, align=left},
  bk arrow/.style={-{Stealth[length=7pt]}, line width=1.3pt},
  % 第6回：図の箱と矢印のきまり。矢印は箱の名前どうしでつなぎ、両端を1.5mm 離す。字は footnotesize 以上
  bk node/.style={draw=bkTheme, line width=0.9pt, fill=white, rounded corners=2mm, align=center,
    font=\sffamily\small, inner xsep=3.5mm, inner ysep=2.5mm},
  bk link/.style={-{Stealth[length=6pt]}, line width=1.1pt, bkGray, shorten <=1.5mm, shorten >=1.5mm},
