    font=\sffamily\bfseries\small, inner xsep=5pt, inner ysep=2.5pt] (s) {#2};\hspace{0.6\zw}}
\newcommand\kangaekata{\bkstep{\R{考}{かんが}え\R{方}{かた}}}
