\DeclareRobustCommand\bkstars[1]{{\sffamily\color{bkStar}\ifcase#1\or★\or★★\or★★★\or★★★★\or★★★★★\fi}}
\DeclareRobustCommand\bklevel[1]{\tikz[baseline=(b.base)]\node[inner xsep=4pt, inner ysep=2pt,
  rounded corners=2pt, draw=bkStar, line width=0.6pt, fill=white] (b)
  {\sffamily\footnotesize\color{bkStar}\bkstars{#1}};}
\DeclareRobustCommand\bklevelrange[2]{\tikz[baseline=(b.base)]\node[inner xsep=4pt, inner ysep=2pt,
  rounded corners=2pt, draw=bkStar, line width=0.6pt, fill=white] (b)
  {\sffamily\footnotesize\color{bkStar}\bkstars{#1}〜\bkstars{#2}};}

