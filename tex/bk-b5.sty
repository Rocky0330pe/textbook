% \bkpart{番号}{部の名前}{色}{しおり用の文字}
\newcommand\bkpart[4]{%
  \clearpage
  \colorlet{bkTheme}{bkVol}%
  \bksetrunning{#1}{}{}\gdef\bk@tabpos{#1}%
  \global\bk@decofalse
  \pdfbookmark[0]{第#1部　#4}{bkpart#1}\gdef\bk@partplain{第#1部　#4}%
  \addtocontents{toc}{\protect\bktocpart{\protect\R{第}{だい}#1\protect\R{部}{ぶ}}{#2}{\thepage}{#3}}%
  \gdef\bk@partlabel{\R{第}{だい}#1\R{部}{ぶ}}\gdef\bk@partname{#2}%
}
\newcommand\bkpartend{\clearpage\global\bk@decotrue}
\def\bk@partlabel{}\def\bk@partname{}\def\bk@partplain{}

% \bkchapter{部}{章}{題名}{レベル表示}{しおり用の文字}
\newcounter{bkfig}\newcounter{bktab}\newcounter{bkreidai}\newcounter{bkjibun}\newcounter{bkmondai}
\newcommand\bkchapter[5]{%
  \bkevenpage
  \global\bk@decotrue
  \setcounter{bkfig}{0}\setcounter{bktab}{0}\setcounter{bkreidai}{0}%
  \setcounter{bkjibun}{0}\setcounter{bkmondai}{0}%
  % 第7回：「序章」にもルビ（第1〜3巻）
  \ifnum#2=0 \gdef\bk@chapnum{\R{序章}{じょ|しょう}}\else\gdef\bk@chapnum{#1-#2}\fi
  \ifnum#2=0 \bksetrunning{}{\R{第}{だい}\bkvol\R{巻}{かん}\hspace{0.8\zw}\R{序章}{じょ|しょう}}{\R{序章}{じょ|しょう}\hspace{0.6\zw}#5}%
  \else\bksetrunning{\bk@tabpos}{\R{第}{だい}\bkvol\R{巻}{かん}\hspace{0.8\zw}\bk@partlabel\hspace{0.6\zw}\bk@partname}{\bk@chapnum\hspace{0.6\zw}#5}\fi
  \pdfbookmark[1]{#1-#2　#5}{bkchap#1-#2}\typeout{BKPAGE chap #1-#2 \thepage}%
  \addtocontents{toc}{\protect\bktocchap{#1-#2}{#3}{#4}{\thepage}}%
  % 題名の高さを測る（上に部の名前の行 0.85 cm、下に 0.4 cm の余白をとる）
  \setbox\bk@titlebox=\hbox{\parbox{\dimexpr\linewidth-3.9cm\relax}{\bk@chaptitlefont\raggedright #3}}%
  \bk@contenth=\dimexpr\ht\bk@titlebox+\dp\bk@titlebox\relax
  \ifdim\bk@contenth<1.75cm \bk@contenth=1.75cm \fi
  \edef\bk@bandh{\strip@pt\dimexpr(\bk@contenth+1.25cm)*20/569\relax}%
  \ifdim\bk@bandh pt<\bk@bandmin pt \edef\bk@bandh{\bk@bandmin}\fi
  \edef\bk@bandmid{\strip@pt\dimexpr(\bk@bandh pt*569/20-0.85cm+0.4cm)/2*20/569\relax}%
  \noindent
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\linewidth,\bk@bandh);
    \clip (0,0) rectangle (\linewidth,\bk@bandh);
    \fill[bkTheme] (0,0) rectangle (\linewidth,\bk@bandh);
    \fill[white, opacity=0.13] (\linewidth-2.2,\bk@bandh) circle (2.0);
    \fill[white, opacity=0.10] (\linewidth-0.6,0) circle (1.3);
    % いちばん上の行：左に部の名前、右に★（上下のまん中をそろえる）
    \node[anchor=west, text=bkOn, font=\sffamily\small] at (0.5,\bk@bandh-0.5)
      {\bk@partlabel\hspace{0.6\zw}\bk@partname};
    \node[anchor=east] at (\linewidth-0.3,\bk@bandh-0.5) {#4};
    \node[anchor=west, circle, fill=white, text=\bkTT, minimum size=1.65cm,
      font=\sffamily\bfseries\Large, inner sep=0pt] (n) at (0.45,\bk@bandmid) {\ifnum#2=0 {\large \R{序章}{じょ|しょう}}\else\ifnum#2>9 {\fontsize{15}{15}\selectfont #1-#2}\else #1-#2\fi\fi};
    \node[anchor=west, text=bkOn, font=\bk@chaptitlefont,
      text width=\linewidth-3.9cm, align=left, inner sep=0pt] at ([xshift=0.35cm]n.east) {#3};
  \end{tikzpicture}\par
  \vspace{4pt}}
\def\bk@chapnum{}
% 章の帯の高さと、番号の丸の高さ（cm）。第1巻は題名の文字が大きいので高くする
\def\bk@bandmin{3.1}\def\bk@bandh{3.1}\def\bk@bandmid{1.3}
\newbox\bk@titlebox\newdimen\bk@contenth
% 章の題名の字。2行になったとき行の間が開きすぎないように、行送りを字の大きさの1.3倍（ルビのある巻は1.55倍）にする
\def\bk@chaptitlefont{\sffamily\bfseries\LARGE\baselineskip=\ifnum\bkvol>3 1.3\else 1.55\fi\dimexpr\f@size pt\relax}

