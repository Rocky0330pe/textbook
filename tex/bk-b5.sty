%% 書きこみらん  \bkwrite[1行目の見出し]{行数}
\NewDocumentCommand\bkwrite{O{} m}{\par\nobreak\vspace{2pt}\noindent
  \begin{tikzpicture}
    \foreach \i in {1,...,#2} \draw[bkLine, line width=0.6pt, dash pattern=on 2pt off 2pt]
      (0,-\i*0.85) -- (\linewidth,-\i*0.85);
    \if\relax\detokenize{#1}\relax\else
      \node[anchor=south west, fill=bkOrange, text=white, rounded corners=1.2mm,
        font=\sffamily\bfseries\small, inner xsep=5pt, inner ysep=2.5pt] at (0,-0.85+0.08) {#1};
    \fi
    \path (0,0) (0,-#2*0.85-0.1);
  \end{tikzpicture}\par}
%% こたえらん  \bkanswerbox{幅}
\NewDocumentCommand\bkanswerbox{O{9\zw} O{}}{\par\vspace{2pt}\noindent#2\hfill
  \tikz[baseline=(a.base)]{\node[font=\sffamily\bfseries\small, text=bkOrange] (a) {\bkkotaelabel};
  \draw[bkOrange, line width=1pt, rounded corners=1.5mm] ([xshift=3pt,yshift=-9pt]a.east) rectangle ++(#1,25pt);}\par}
%% 第2巻からは、問題はノートに解く（本には書きこまない）。書きこみらんの命令は何もしない。
%% ヒントだけは残す。第1巻は本に書きこむ（数字を書く練習も兼ねる）。
\ifnum\bkvol>1\relax
  \RenewDocumentCommand\bkwrite{O{} m}{}
  \RenewDocumentCommand\bkanswerbox{O{9\zw} O{}}{\if\relax\detokenize{#2}\relax\else\par\vspace{2pt}\noindent#2\par\fi}
\fi
