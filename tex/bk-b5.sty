\newcommand\bktableofcontents{\@starttoc{toc}}
% 部の行  \bktocpart{番号の表示}{部の名前}{ページ}{色}
\newcommand\bktocpart[4]{%
  \par\addvspace{5pt}\noindent
  \begin{tikzpicture}[baseline=(t.base)]
    \node[anchor=west, fill=#4, text=white, rounded corners=3pt, inner xsep=6pt, inner ysep=3pt,
      text width=\dimexpr\linewidth-12pt\relax, font=\sffamily\bfseries] (t)
      {#1\hspace{0.8\zw}#2\hfill\mdseries #3};
  \end{tikzpicture}\par\nobreak\vspace{2pt}}
% 章の行  \bktocchap{番号}{題名}{レベル}{ページ}  ページが空 → 原稿準備中（灰色）
\newcommand\bktocchap[4]{%
  \par\noindent
  \begingroup
  \def\bk@tmp{#4}%
  \ifx\bk@tmp\@empty\color{bkGray}\fi
  \def\\{}\rightskip=0pt plus 4em\relax
  \hangindent=4.2\zw\hangafter=1
  \hspace{1\zw}\makebox[3.2\zw][l]{\sffamily\bfseries #1}#2%
  \nobreak\leaders\hbox to 0.8em{\hss{\color{bkLine}・}\hss}\hfill\nobreak
  \makebox[4.5em][r]{\let\bklevel\bkstars\def\bklevelrange##1##2{\bkstars{##1}〜\bkstars{##2}}\scriptsize #3}%
  \makebox[2em][r]{\sffamily #4}\par\endgroup}
\newcommand\bktocplain[2]{% 前付・後付の行
  \par\noindent{\sffamily\bfseries #1}\nobreak
  \leaders\hbox to 0.8em{\hss{\color{bkLine}・}\hss}\hfill\nobreak
  \makebox[2.2em][r]{\sffamily #2}\par}
% 原稿がまだない章を目次にだけ出す
\newcommand\bkplannedpart[3]{\addtocontents{toc}{\protect\bktocpart{#1}{#2}{}{#3!45}}}
\newcommand\bkplannedchap[3]{\addtocontents{toc}{\protect\bktocchap{#1}{#2}{#3}{}}}
\newcommand\bktocentry[1]{\addtocontents{toc}{\protect\bktocplain{#1}{\thepage}}}

%% ------------------------------------------------------------
%% 7b. ページ制限なし（第11回）：章・部扉はかならず偶数ページ（左）から。
%%     前の章が奇数ページで終わったときは、まるごと1ページのメモらんを入れる。
%%     奥付の前では、本全体が4の倍数になるまでメモのページを足す（\bkpadfour）。
%% ------------------------------------------------------------
\newcommand\bkmemopage{%
  \clearpage
  \noindent\begin{tikzpicture}[x=1mm, y=1mm]
    \pgfmathsetmacro\bk@mh{(\textheight-4mm)/1mm}\pgfmathsetmacro\bk@mw{\linewidth/1mm}%
    \draw[bkLine, line width=0.6pt, rounded corners=2.5mm] (0,0) rectangle (\bk@mw,\bk@mh);
    \node[anchor=north west, inner sep=0pt, text=bkGray, font=\sffamily\bfseries\small] at (4,\bk@mh-3.5) {メモ};
    \pgfmathtruncatemacro\bk@mn{(\bk@mh-14)/9}%
    \foreach \i in {1,...,\bk@mn} \draw[bkLine, line width=0.5pt, dash pattern=on 1.5pt off 2pt]
      (4,\bk@mh-6-\i*9) -- (\bk@mw-4,\bk@mh-6-\i*9);
  \end{tikzpicture}\par
  \clearpage}
\newcommand\bkevenpage{\clearpage\ifodd\value{page}\bkmemopage\fi}
\newcommand\bkpadfour{\clearpage
  \loop\ifnum\directlua{tex.print(math.tointeger(math.fmod(tex.count['c@page'],4)))}>0 \bkmemopage\repeat
  \typeout{BKPAGE colophon \thepage}}

