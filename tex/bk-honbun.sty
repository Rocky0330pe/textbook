  \filldraw[fill=white, draw=bkGray!70, line width=0.8pt] (0,0) ellipse ({#2/2} and {#2/7});
  \draw[bkLine, line width=0.6pt] (0,0) ellipse ({#2/2*0.72} and {#2/7*0.68});\end{scope}}
% 人（ピクトグラム）  \bkperson{(x,y)}{高さ}{色}
\newcommand\bkperson[3]{\begin{scope}[shift={#1}, scale=#2/10]
  \fill[#3] (0,8.6) circle (1.4);
  \fill[#3, rounded corners=1.2] (-2.1,3.4) rectangle (2.1,7);
  \fill[#3, rounded corners=0.6] (-1.7,0) rectangle (-0.25,4) (0.25,0) rectangle (1.7,4);\end{scope}}
% ふうせん  \bkballoon{(x,y)}{半径}{色}
\newcommand\bkballoon[3]{\begin{scope}[shift={#1}]
  \draw[bkGray, line width=0.5pt] (0,-#2) .. controls (0.3*#2,-1.6*#2) and (-0.3*#2,-2.1*#2) .. (0.1*#2,-2.7*#2);
  \fill[#3] (0,0) ellipse ({#2} and {1.15*#2});
  \fill[#3] (-0.18*#2,-1.12*#2) -- (0.18*#2,-1.12*#2) -- (0,-1.0*#2) -- cycle;
  \fill[white, opacity=0.4] (-0.4*#2,0.4*#2) ellipse ({0.18*#2} and {0.28*#2});\end{scope}}
% 10のわく  \bktenframe{(x,y)}{マスの大きさ}{入っている数}{色}{あとから入れる数}{あとの色}
\newcommand\bktenframe[6]{\begin{scope}[shift={#1}]
  \foreach \i in {0,...,9} {
    \pgfmathtruncatemacro\cx{mod(\i,5)}\pgfmathtruncatemacro\cy{1-div(\i,5)}
    \draw[bkInk!70, line width=0.8pt, fill=white] (\cx*#2,\cy*#2) rectangle ++(#2,#2);
    \ifnum\i<#3\relax \fill[#4] (\cx*#2+#2/2,\cy*#2+#2/2) circle (0.36*#2);
    \else\pgfmathtruncatemacro\lim{#3+#5}\ifnum\i<\lim\relax \fill[#6] (\cx*#2+#2/2,\cy*#2+#2/2) circle (0.36*#2);\fi\fi}
  \draw[bkInk, line width=1.4pt] (0,0) rectangle (5*#2,2*#2);\end{scope}}
% ものさし  \bkruler{(x,y)}{目もり1つの長さ}{最大}
\newcommand\bkruler[3]{\begin{scope}[shift={#1}]
  \fill[bkYellowBg, draw=bkYellow!80!black, line width=0.8pt, rounded corners=1mm] (-4,-9) rectangle (#3*#2+4,3);
  \foreach \i in {0,...,#3} {\draw[bkInk, line width=0.8pt] (\i*#2,3) -- (\i*#2,-2.5);
    \node[font=\sffamily\bfseries\small, text=bkInk] at (\i*#2,-5.6) {\i};}
  \foreach \i in {1,...,#3} \draw[bkInk, line width=0.5pt] (\i*#2-#2/2,3) -- (\i*#2-#2/2,0.5);
\end{scope}}
% ものさしの上をすすむ矢印  \bkhop{(x,y)}{目もり1つの長さ}{はじめ}{すすむ数}{色}
\newcommand\bkhop[5]{\begin{scope}[shift={#1}]
  \pgfmathtruncatemacro\bkhopend{#3+#4-1}
  \foreach \i in {#3,...,\bkhopend} \draw[#5, line width=1.3pt, -{Stealth[length=5pt]}] (\i*#2+0.6,4) .. controls (\i*#2+0.25*#2,10) and (\i*#2+0.75*#2,10) .. (\i*#2+#2-0.6,4.2);
  \fill[#5] (#3*#2,3.2) circle (1.6);\end{scope}}
% バス  \bkbus{(x,y)}{乗っている人数}{色}
\newcommand\bkbus[3]{\begin{scope}[shift={#1}]
  \fill[#3, rounded corners=3mm] (0,4) rectangle (78,30);
  \fill[#3!70!black] (0,4) rectangle (78,7);
  \foreach \i in {0,...,5} {\fill[white, rounded corners=1mm] (5+\i*11.2,16) rectangle ++(9,10);
    \ifnum\i<#2\relax \fill[bkSkin] (9.5+\i*11.2,21.5) circle (2.2); \fill[bkInk!75, rounded corners=1mm] (6.8+\i*11.2,16) rectangle ++(5.4,3.4);\fi}
  \fill[bkInk!80] (16,4) circle (4.2) (62,4) circle (4.2);
  \fill[bkLine] (16,4) circle (1.8) (62,4) circle (1.8);
  \fill[bkYellow] (74.5,10) rectangle (77.5,13);\end{scope}}

