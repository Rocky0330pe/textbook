%% ------------------------------------------------------------
%% 8. 第1巻の本文：大きな文字と分かち書き
%%   文節の切れ目（空白）と句読点のあとだけで改行する。行の右はそろえない。
%% ------------------------------------------------------------
% 空白（文節の切れ目）の直前に置かれた「改行禁止」を外して、空白で改行できるようにする
\newattribute\bk@wakachi
\directlua{
  local wak = luatexbase.attributes['bk@wakachi']
  local GLUE, PEN = node.id('glue'), node.id('penalty')
  local function fix(head)
    for g in node.traverse_id(GLUE, head) do
      if (g.subtype == 13 or g.subtype == 14) and node.has_attribute(g, wak) == 1 then
        local p = g.prev
        while p and p.id == PEN do
          if p.penalty >= 10000 then p.penalty = 0 end
          p = p.prev
        end
        local n = g.next
        while n and n.id == PEN do
          if n.penalty >= 10000 then n.penalty = 0 end
          n = n.next
        end
      end
    end
    % 第5回：分かち書きでは、空白と句読点のあと以外では改行しない（漢字の熟語・数と単位・ルビの語の途中で切らない）。
    % しき（3 ＋ 2 ＝ 5）は、記号の前後の空白でも改行しない。
    local GLYPH, HLIST, RULE, WHATSIT, KERN = node.id('glyph'), node.id('hlist'), node.id('rule'), node.id('whatsit'), node.id('kern')
    local punct = {[0x3001]=true,[0x3002]=true,[0xFF0C]=true,[0xFF0E]=true,[0xFF01]=true,[0xFF1F]=true,[0xFF09]=true,
      [0x300D]=true,[0x300F]=true,[0x3011]=true,[0x30FB]=true,[0xFF1A]=true,[0xFF1B]=true,[0x2026]=true,[0x2C]=true,[0x2E]=true}
    local ops = {[0xFF0B]=true,[0xFF0D]=true,[0xD7]=true,[0xF7]=true,[0xFF1D]=true,[0x2212]=true,[0xFF1C]=true,[0xFF1E]=true}
    local function content(x) return x and (x.id == GLYPH or x.id == HLIST or x.id == RULE or x.id == WHATSIT) end
    % LuaTeX-ja が全角の記号の前後に入れる はば0の rule も、とばして となりの字を見る
    local function skip(y) return y.id == GLUE or y.id == PEN or y.id == KERN or (y.id == RULE and y.width == 0) end
    local function prevc(x) local y = x.prev while y and skip(y) do y = y.prev end return y end
    local function nextc(x) local y = x.next while y and skip(y) do y = y.next end return y end
    % 箱（\mbox など）は、空白に くっついている がわの はしの 字だけを 見る（箱の 中ほどの 記号では 止めない）
    local function isop(x, last)
      if not x then return false end
      if x.id == GLYPH then return ops[x.char] or false end
      if x.id == HLIST and x.head then
        local e = nil
        for g in node.traverse_id(GLYPH, x.head) do if not last then e = g break end e = g end
        return (e and ops[e.char]) or false
      end
      return false
    end
    local function lock(x)
      local y = x.prev
      while y and (y.id == PEN or (y.id == RULE and y.width == 0)) do if y.id == PEN then y.penalty = 10000 end y = y.prev end
      y = x.next
      while y and (y.id == PEN or (y.id == RULE and y.width == 0)) do if y.id == PEN then y.penalty = 10000 end y = y.next end
      local pn = node.new(PEN) pn.penalty = 10000
      head = node.insert_before(head, x, pn)
    end
    local todo, nt = {}, 0
    for g in node.traverse_id(GLUE, head) do
      if node.has_attribute(g, wak) == 1 then
        local p, q = prevc(g), nextc(g)
        if content(p) and content(q) then
          if g.subtype == 13 or g.subtype == 14 then
            if isop(p, true) or isop(q, false) then nt = nt + 1 todo[nt] = g end
          elseif g.subtype == 0 and g.stretch_order == 0 and g.width < 400000 then
            if not (p.id == GLYPH and punct[p.char]) then nt = nt + 1 todo[nt] = g end
          end
        end
      end
    end
    for _, g in ipairs(todo) do lock(g) end
    return head
  end
  luatexbase.add_to_callback('pre_linebreak_filter', fix, 'bk.wakachi')
}
% 分かち書きの改行（空白と句読点のところだけで改行し、行の右はそろえない）。グループの中だけで効く
\newcommand\bkwakachi{%
  % ひらがな・カタカナの前後では改行しない（空白と句読点のところで改行する）
  \@tempcnta="3041\relax
  \loop
    \ltjsetparameter{prebreakpenalty={\@tempcnta,10000}, postbreakpenalty={\@tempcnta,10000}}%
    \advance\@tempcnta\@ne
  \ifnum\@tempcnta<"30FF\repeat
  \ltjsetparameter{prebreakpenalty={`ー,10000}}%
  \bk@wakachi=1\relax
  \rightskip=0pt plus 1fil\relax\@rightskip=0pt plus 1fil\relax\parfillskip=0pt plus 1fil\relax}
