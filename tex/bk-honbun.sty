\newtcolorbox{bkcodeout}[1][実行結果]{enhanced, colback=bkInk!85, colframe=bkInk!85, boxrule=0.7pt, arc=1.5mm,
  left=3mm, right=3mm, top=1.2mm, bottom=1.2mm, before skip=3pt, after skip=3pt, coltext=white,
