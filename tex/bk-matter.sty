\newcommand\bkartpage[2]{% {ページ番号の表示名}{TikZのコード}
  \clearpage
  \begingroup
  \global\bk@decofalse\bkfolio{false}%
  \def\thepage{#1}%
  \AddToHookNext{shipout/background}{\put(0,-\paperheight){%
    \begin{tikzpicture}[overlay, x=1mm, y=1mm]#2\end{tikzpicture}}}%
  \thispagestyle{empty}\null\clearpage
  \endgroup
  \global\bk@decotrue\bkfolio{true}}

