\newcommand\bk@cropmarks[4]{% 仕上がりの左下x, 左下y, 幅, 高さ（日本式の二重トンボ）
  \begin{scope}[line width=0.25pt, black]
    \foreach \cx/\sx in {#1/-1, #1+#3/1} \foreach \cy/\sy in {#2/-1, #2+#4/1} {
      \draw (\cx+\sx*3,\cy+\sy*13) -- (\cx+\sx*3,\cy+\sy*3) -- (\cx+\sx*13,\cy+\sy*3);
      \draw (\cx,\cy+\sy*13) -- (\cx,\cy+\sy*3);
      \draw (\cx+\sx*13,\cy) -- (\cx+\sx*3,\cy);
    }
    \foreach \cx in {#1+#3/2} {\draw (\cx,#2-3) -- (\cx,#2-13) (\cx-6,#2-8) -- (\cx+6,#2-8);
      \draw (\cx,#2+#4+3) -- (\cx,#2+#4+13) (\cx-6,#2+#4+8) -- (\cx+6,#2+#4+8);}
    \foreach \cy in {#2+#4/2} {\draw (#1-3,\cy) -- (#1-13,\cy) (#1-8,\cy-6) -- (#1-8,\cy+6);
      \draw (#1+#3+3,\cy) -- (#1+#3+13,\cy) (#1+#3+8,\cy-6) -- (#1+#3+8,\cy+6);}
  \end{scope}}
\newcommand\bkCoverWrapArt[1]{% 背の幅（mm）。原点＝仕上がりの左下（紙の端から18 mm内側）
  \pgfmathsetmacro\bk@W{182+#1+182}%
  \begin{scope}
    \clip (-3,-3) rectangle (\bk@W+3,260);
    \begin{scope}\clip (-3,-3) rectangle (182,260);\bkBackArt\end{scope}
    \begin{scope}[shift={(182,0)}]\bkSpineArt{#1}\end{scope}
    \begin{scope}[shift={(182+#1,0)}]\clip (0,-3) rectangle (185,260);\bkFrontArt\end{scope}
  \end{scope}
  \bk@cropmarks{0}{0}{\bk@W}{257}
  \foreach \x in {182, 182+#1} {\draw[line width=0.25pt] (\x,-3) -- (\x,-13) (\x,260) -- (\x,270);}
  \node[anchor=south west, inner sep=0pt, font=\sffamily\fontsize{6.5}{8}\selectfont] at (16,263)
    {\def\R##1##2{##1}\bkSeriesPlain　第\bkvol 巻　カバー展開図（表4・背・表1）　仕上がり B5（182×257 mm）　背幅 #1 mm（本文\bk@totalpages ページ・紙厚0.09 mmで計算）　塗り足し 3 mm　CMYK};
}
\newcommand\bkCoverWrapPage[1]{%
  \AddToHookNext{shipout/background}{\put(0,-\paperheight){%
    \begin{tikzpicture}[overlay, x=1mm, y=1mm]\begin{scope}[shift={(18,18)}]\bkCoverWrapArt{#1}\end{scope}\end{tikzpicture}}}%
  \thispagestyle{empty}\null\clearpage}

