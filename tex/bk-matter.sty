\newcommand\bk@ifsub[2]{\setbox0\hbox{\bkSub{\bkvol}}\ifdim\wd0>0pt #1\else #2\fi}
% 全9巻の帯  \bk@lineup{x}{y}
\newcommand\bk@lineup[2]{%
  \foreach \i in {1,...,9} {
    \pgfmathsetmacro\bk@lx{#1+(\i-1)*16.75}
    \ifnum\i=\bkvol\relax
      \fill[bkVol!100] (\bk@lx,#2-4) rectangle ++(14.4,22);
      \fill[bkVol] (\bk@lx+7.2-2.6,#2+20.6) -- ++(5.2,0) -- ++(-2.6,3.4) -- cycle;
      \node[text=bkBandOn\i, font=\sffamily\bfseries\fontsize{17}{17}\selectfont] at (\bk@lx+7.2,#2+7) {\i};
    \else
      \fill[bkVol\i] (\bk@lx,#2) rectangle ++(14.4,14);
      \node[text=bkBandOn\i, font=\sffamily\bfseries\fontsize{12}{12}\selectfont] at (\bk@lx+7.2,#2+7) {\i};
    \fi
  }}
