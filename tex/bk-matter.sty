  \fill[bkInk!80] (-2.2,0.3) ellipse (2.2 and 1.1) (2.2,0.3) ellipse (2.2 and 1.1);
  \ifnum#2=1
    \draw[#1, line width=2.4mm, line cap=round] (-5,24.5)--(-8.6,18) (5,24.5)--(9,31.5);
    \fill[bkSkin] (-8.9,17.3) circle (1.5) (9.3,32.3) circle (1.5);
  \else
    \draw[#1, line width=2.4mm, line cap=round] (-5,24.5)--(-8.4,16.5) (5,24.5)--(8.4,16.5);
    \fill[bkSkin] (-8.7,15.8) circle (1.5) (8.7,15.8) circle (1.5);
