\newcommand\bkdefvol[7]{% 番号, 題名, 副題, キャッチ, 学年の目安, ★最小, ★最大
  \@namedef{bk@title@#1}{#2}\@namedef{bk@sub@#1}{#3}\@namedef{bk@catch@#1}{#4}%
  \@namedef{bk@grade@#1}{#5}\@namedef{bk@smin@#1}{#6}\@namedef{bk@smax@#1}{#7}}
\newcommand\bkTitle[1]{\@nameuse{bk@title@#1}}
\newcommand\bkSub[1]{\@nameuse{bk@sub@#1}}
\newcommand\bkCatch[1]{\@nameuse{bk@catch@#1}}
\newcommand\bkGrade[1]{\@nameuse{bk@grade@#1}}
\newcommand\bkSmin[1]{\@nameuse{bk@smin@#1}}
\newcommand\bkSmax[1]{\@nameuse{bk@smax@#1}}
\newcommand\bkdefroute[5]{% 番号, 名前, 説明, この巻の駅, 終点
  \@namedef{bk@rname@#1}{#2}\@namedef{bk@rsub@#1}{#3}\@namedef{bk@rhere@#1}{#4}\@namedef{bk@rend@#1}{#5}}
\newcommand\bkdefpart[4]{% 番号, ラベル, 名前, 章の範囲
  \@namedef{bk@plabel@#1}{#2}\@namedef{bk@pname@#1}{#3}\@namedef{bk@prange@#1}{#4}}
\newcommand\bkSeries{\R{物理}{ぶつ|り}を\R{理解}{り|かい}するための\R{数学}{すう|がく}}
\newcommand\bkSeriesPlain{物理を理解するための数学}
\newcommand\bkEditor{「\bkSeries」\R{編集委員会}{へん|しゅう|い|いん|かい}}
\newcommand\bkVolLabel[1][\bkvol]{\R{第}{だい}#1\R{巻}{かん}}

