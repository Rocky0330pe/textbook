\newcommand\bk@tocpill[2]{% 番号, 種類
  \def\bk@k{#2}\def\bk@J{J}\def\bk@E{E}\def\bk@R{R}%
  \ifx\bk@k\bk@J\def\bk@lab{\R{序章}{じょ|しょう}}\else\ifx\bk@k\bk@E\def\bk@lab{\R{終章}{しゅう|しょう}}\else\def\bk@lab{#1}\fi\fi
  \ifx\bk@k\bk@R
    \tikz[baseline=(p.base)]\node[draw=bkVol, line width=0.8pt, fill=white, text=bkDeep, rounded corners=1.3mm,
      minimum width=11.5mm, inner xsep=1mm, inner ysep=1.1mm, font=\sffamily\bfseries\fontsize{9}{10}\selectfont] (p) {\bk@lab};%
  \else
    \tikz[baseline=(p.base)]\node[fill=bkVol, text=bkOn, rounded corners=1.3mm,
      minimum width=11.5mm, inner xsep=1mm, inner ysep=1.1mm, font=\sffamily\bfseries\fontsize{9}{10}\selectfont] (p) {\bk@lab};%
  \fi}
% 章の行の右側（路線アイコン・★・ページ）。3つの中心の高さをそろえ、題名の字面の中心に合わせる
% ページ番号  \bkpageno{番号}  → P.番号（「P.」は小さく）
\newcommand\bkpageno[1]{{\fontsize{0.72em}{1em}\selectfont P.}\kern0.06em#1}
\newcommand\bk@tocmeta[4]{%
  \begin{tikzpicture}[baseline=-0.38em, x=1mm, y=1mm]
    \path[use as bounding box] (0,-1) rectangle (36,1);
    \node[anchor=east, inner sep=0pt, text=bkInk, font=\sffamily\bfseries\fontsize{11}{12}\selectfont] (pg) at (36,0) {\bkpageno{#4}};
    \node[anchor=east, inner sep=0pt] (st) at (23.5,0) {\bkstarmeter{#2}{#3}};
    \def\bk@r{#1}\def\bk@all{all}%
    \ifx\bk@r\bk@all
      \node[anchor=east, inner sep=0pt, text=bkDeep, font=\sffamily\bfseries\fontsize{7.5}{9}\selectfont] at ([xshift=-2mm]st.west) {\R{全}{ぜん}\R{路線}{ろ|せん}};
    \else
      \foreach \r [count=\k] in {#1} {\xdef\bk@nr{\k}}%
      \foreach \r [count=\k] in {#1} {
        \node[anchor=east, inner sep=0pt] at ([xshift={-2mm-(\bk@nr-\k)*4.4mm}]st.west) {\bkrouteicon[0.95em]{\r}};}
    \fi
  \end{tikzpicture}}
% 章の行  \bktocchap{番号}{題名}{ひとこと}{路線}{★最小}{★最大}{ページ}{種類}
\renewcommand\bktocchap[8]{%
  \par\noindent
  \parbox[t]{14mm}{\leavevmode\bk@tocpill{#1}{#8}}%
  \parbox[t]{\dimexpr\linewidth-14mm-36mm\relax}{\setlength\parskip{0pt}%
    \leavevmode{\bk@tocTitle\color{bkInk}#2\def\bk@k{#8}\def\bk@R{R}\ifx\bk@k\bk@R\hspace{0.5em}{\fontsize{8}{9}\selectfont\color{bkDeep}［\R{読}{よ}みもの］}\fi}}%
  \parbox[t]{36mm}{\leavevmode{\bk@tocTitle\bk@tocmeta{#4}{#5}{#6}{#7}}}%
  \par\nobreak\vspace{-\bk@tochookup}\noindent\hspace{14mm}%
  \parbox[t]{\dimexpr\linewidth-14mm\relax}{\setlength\parskip{0pt}\bk@tocKid
    \leavevmode{\bk@tocHook\color{bkGray}#3}}%
  \par\nobreak\vspace{\dimexpr\bk@tocgap+\bk@tochookup\relax}{\color{bkLine}\hrule height 0.35pt}\vspace{\bk@tocgap}}
