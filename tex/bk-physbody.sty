%% 9. 例題の段  \phstep{段の名前}（番号は例題ごとに①から）。それだけで1行。
%%    決まった7つの段：\phbamen \phmushi \phzu \phriyu \phtateru \phtoku \phtashikame
%%    例題の囲み：数学の reidai（ページをまたがない）と、ページをまたいでよい phreidai（物理の長い例題）。番号は共通。
%% ------------------------------------------------------------
\newcommand\phstep[1]{%
  \edef\ph@tmp{\thebkreidai}\ifx\ph@tmp\ph@stepof\else\setcounter{phstep}{0}\xdef\ph@stepof{\ph@tmp}\fi
  \stepcounter{phstep}%
  \par\addvspace{4pt}\noindent
  \tikz[baseline=(c.base)]\node[circle, fill=bkBlue!85!black, text=white, minimum size=1.25em, inner sep=0pt,
    font=\sffamily\bfseries\footnotesize] (c) {\arabic{phstep}};\hspace{0.45em}%
  {\sffamily\bfseries\color{bkBlue!70!black}#1}\par\nobreak\vspace{1pt}\noindent\ignorespaces}
\newcommand\phbamen{\phstep{場面}}
\newcommand\phmushi{\phstep{何を無視するか（理想化）}}
\newcommand\phzu{\phstep{図と記号}}
\newcommand\phriyu{\phstep{使う式を選ぶ理由}}
\newcommand\phtateru{\phstep{式を立てる}}
\newcommand\phtoku{\phstep{解く}}
\newcommand\phtashikame{\phstep{答えを確かめる（単位・大きさ・極端な場合）}}
