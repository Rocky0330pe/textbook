%% bk-physbody.sty
%% 第13回編集委員会（物理第1巻）：『工学を理解するための物理』の本文を組むための部品（組 P-0：組版のしくみ）
%%   章の頭（\phchapter）・部（\phPartPages・\phpartbegin）・道しるべの物理の章の札、
%%   物理で足す囲み（モデル化の札・次元チェック・桁の感覚・工学の駅・この式の読み方・身近な例では・
%%   〇〇を2倍にすると？・まだわかっていないこと・この先は大学で・一般の式から中学・高校の公式へ・
%%   この章で導く中学・高校の公式・段つきの例題・入試にチャレンジ・工学ではこう使う・3段）
%% 読む順：bk-b5.sty（vol=5：ルビなし）→ bk-matter → bk-honbun → bk-volume → bk-pict1 → bk-phys → bk-physbody。
%% 数学シリーズのファイルは変えない。数学の部品の見た目はそのままで、物理のときだけ効く（このファイルは物理の親ファイルだけが読む）。
%% 使い方の説明は tools/BRIEF-phys-parts.md。
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bk-physbody}[2026/10/22 v0.1 physics series body parts]
\makeatletter

%% ------------------------------------------------------------
%% 0. 巻の頭文字（力・熱・波・電・原）と、章の札の色
%% ------------------------------------------------------------
\@namedef{ph@key@1}{力}\@namedef{ph@key@2}{熱}\@namedef{ph@key@3}{波}\@namedef{ph@key@4}{電}\@namedef{ph@key@5}{原}
\@namedef{ph@keyno@力}{1}\@namedef{ph@keyno@熱}{2}\@namedef{ph@keyno@波}{3}\@namedef{ph@keyno@電}{4}\@namedef{ph@keyno@原}{5}
\edef\phkey{\@nameuse{ph@key@\phvol}}
% 範囲の書き方：\qtyrange{9.78}{9.83}{m/s^2} → 9.78〜9.83 m/s²（物理の本だけ）
\sisetup{range-phrase={〜}, range-units=single}
% 章の始まりのページ（ph<n>-meta.tex が \phdefchappage{力-1}{14} の形で書く。もくじ・地図・道すじで使う）
\newcommand\phdefchappage[2]{\@namedef{ph@cp@#1}{#2}}
\newcommand\phchappage[1]{\ifcsname ph@cp@#1\endcsname\@nameuse{ph@cp@#1}\else ?\fi}

%% 道しるべ・思い出そうの章の札：物理の章（力-3・熱-2 など）は物理の巻の色、数学の章（4-11 など）は今までどおり数学の巻の色
\let\ph@mathpill\bk@pill
\renewcommand\bk@pill[1]{\edef\bk@pv{\expandafter\bk@getvol#1\relax}%
  \ifcsname ph@keyno@\bk@pv\endcsname
    \edef\bk@pv{\csname ph@keyno@\bk@pv\endcsname}%
    \tikz[baseline=(p.base)]\node[fill=phVol\bk@pv, text=phOn\bk@pv, rounded corners=1mm, inner xsep=1.6mm, inner ysep=0.8mm,
      font=\sffamily\bfseries\fontsize{8}{9}\selectfont] (p) {#1};%
  \else\ph@mathpill{#1}\fi}
% 本文の中で章を指す札（ページつき）  \phchapref{力-3}  → [力-3] P.46
\newcommand\phchapref[1]{\mbox{\bk@pill{#1}\,{\sffamily\footnotesize\color{bkGray}\bkpageno{\phchappage{#1}}}}}

