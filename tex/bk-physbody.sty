  \begingroup
  \def\phk##1##2##3{\unexpanded{##1 & ##2 & \ph@kref{##3} \\}}%
  \def\phkx##1##2##3{\unexpanded{##1 & ##2 & {\footnotesize ##3} \\}}%
  \edef\ph@kbody{#1}%
  \small\noindent
  \begin{tblr}[expand=\ph@kbody]{colspec={X[l,m] Q[l,m,wd=33mm] Q[c,m,wd=21mm]}, width=\linewidth,
    row{1}={bg=bkTheme!12, font=\sffamily\bfseries\footnotesize}, hlines={0.4pt,bkLine}, rowsep=1.6pt, colsep=4pt}
