%% ------------------------------------------------------------
%% 3. 章の頭  \phchapter[読みもの]{番号}{題名（2行は \\）}{なぜ？}{★}{柱・しおりの題名}
%%    番号は数（力-1 なら 1、序章は 0）。章の番号は「力-1」の形（\phkey は巻の頭文字）。
%%    帯：左上に部の名前、右上に★、白い丸に番号、題名の下に「なぜ？」の副題。
%%    柱：偶数ページ「力学　第1部　動く」、奇数ページ「力-1　題名」。つめ：部の番号。
%%    BKPAGE chap 力-1 <ページ> をログに書く（tools/syncpages.py p1 が読む）。
%% ------------------------------------------------------------
\newcounter{phstep}\def\ph@stepof{}
\def\ph@partshort{}
\newcommand\ph@hookicon{\tikz[baseline=-0.36em]{\fill[white] (0,0) circle (0.5em);
  \node[inner sep=0pt, text=bkDeep, font=\sffamily\bfseries\fontsize{0.78em}{0.78em}\selectfont] at (0.02em,-0.02em) {?};}}
\newbox\ph@titlebox
\NewDocumentCommand\phchapter{o m m m m m}{%
  \bkevenpage
  \global\bk@decotrue
  \setcounter{bkfig}{0}\setcounter{bktab}{0}\setcounter{bkreidai}{0}%
  \setcounter{bkjibun}{0}\setcounter{bkmondai}{0}\gdef\ph@stepof{}%
  \ifnum#2=0 \gdef\bk@chapnum{序章}\else\xdef\bk@chapnum{\phkey-#2}\fi
  \xdef\ph@chapid{\phkey-#2}%
  \ifnum#2=0
    \bksetrunning{}{\phTitle{\phvol}\hspace{0.8\zw}序章}{序章\hspace{0.6\zw}#6}%
  \else
    \bksetrunning{\bk@tabpos}{\phTitle{\phvol}\hspace{0.8\zw}\bk@partlabel\hspace{0.6\zw}\ph@partshort}{\bk@chapnum\hspace{0.6\zw}#6}%
  \fi
  \pdfbookmark[1]{\ph@chapid　#6}{phchap\ph@chapid}\typeout{BKPAGE chap \ph@chapid\space\thepage}%
  % 題名と「なぜ？」の高さを測って、帯の高さを決める（上に部の名前の行 0.85 cm、下に 0.4 cm）
  \setbox\ph@titlebox=\hbox{\parbox{\dimexpr\linewidth-3.9cm\relax}{\ph@chaptitle{#3}{#4}}}%
  \bk@contenth=\dimexpr\ht\ph@titlebox+\dp\ph@titlebox\relax
  \ifdim\bk@contenth<1.75cm \bk@contenth=1.75cm \fi
  \edef\bk@bandh{\strip@pt\dimexpr(\bk@contenth+1.25cm)*20/569\relax}%
  \ifdim\bk@bandh pt<\bk@bandmin pt \edef\bk@bandh{\bk@bandmin}\fi
  \edef\bk@bandmid{\strip@pt\dimexpr(\bk@bandh pt*569/20-0.85cm+0.4cm)/2*20/569\relax}%
  \noindent
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\linewidth,\bk@bandh);
    \clip (0,0) rectangle (\linewidth,\bk@bandh);
    \fill[bkTheme] (0,0) rectangle (\linewidth,\bk@bandh);
    % 設計図の方眼（表紙と同じしるし。うすく）
    \begin{scope}[x=1mm, y=1mm]
      \draw[white, opacity=0.07, line width=0.25pt, step=5] (-5,-5) grid (150,60);
    \end{scope}
    \fill[white, opacity=0.12] (\linewidth-2.2,\bk@bandh) circle (2.0);
    \node[anchor=west, text=bkOn, font=\sffamily\small] at (0.5,\bk@bandh-0.5)
      {\ifnum#2=0 \phTitle{\phvol}\else\bk@partlabel\hspace{0.6\zw}\bk@partname\fi
       \IfValueT{#1}{\hspace{0.8\zw}\tikz[baseline=(r.base)]\node[draw=white, line width=0.6pt, rounded corners=1mm, inner xsep=1.4mm, inner ysep=0.4mm, text=bkOn, font=\sffamily\bfseries\footnotesize] (r) {#1};}};
    \node[anchor=east] at (\linewidth-0.3,\bk@bandh-0.5) {#5};
    \node[anchor=west, circle, fill=white, text=\bkTT, minimum size=1.65cm,
      font=\sffamily\bfseries\Large, inner sep=0pt] (n) at (0.45,\bk@bandmid)
      {\ifnum#2=0 {\large 序章}\else\ifnum#2>9 {\fontsize{14}{14}\selectfont \phkey-#2}\else{\fontsize{16}{16}\selectfont \phkey-#2}\fi\fi};
    \node[anchor=west, text=bkOn, text width=\linewidth-3.9cm, align=left, inner sep=0pt]
      at ([xshift=0.35cm]n.east) {\ph@chaptitle{#3}{#4}};
  \end{tikzpicture}\par
  \vspace{4pt}}
% 題名と「なぜ？」の副題
\newcommand\ph@chaptitle[2]{{\bk@chaptitlefont\raggedright #1\par}%
  \if\relax\detokenize{#2}\relax\else
  \vspace{1.6mm}{\sffamily\fontsize{10.5}{15}\selectfont\raggedright\hangindent=1.45em\hangafter=1
    \ph@hookicon\hspace{0.45em}#2\par}\fi}

%% ------------------------------------------------------------
%% 4. 部  \phPartPages{部の番号}{問いのリスト 172/{…},160/{…},148/{…}}{デルタのせりふ}{この部を読むと…}
%%    左ページ：部扉（巻の色の面に部の名前と4つの顔の絵）、右ページ：この部で学ぶこと（ph<n>-part<k>.tex）
%%    そのあと \phpartbegin{番号} で柱・つめを部に合わせる（\phPartPages の中でよぶ）
%% ------------------------------------------------------------
\newcommand\phpartbegin[1]{%
  \gdef\bk@partlabel{第#1部}\xdef\bk@partname{\@nameuse{ph@pname@#1}}\gdef\bk@tabpos{#1}%
  \xdef\ph@partshort{\@nameuse{ph@fword@\@nameuse{ph@pface@#1}}}%
  \pdfbookmark[0]{第#1部　\@nameuse{ph@pname@#1}}{phpart#1}}
% 部の名前を「動く」（大きく）と「：質点と質点系」（小さく）に分けて出す
\def\ph@splitname#1：#2\@nil{#1{\fontsize{22}{26}\selectfont ：#2}}
\newcommand\phPartPages[4]{%
  \edef\ph@pn{\@nameuse{ph@pname@#1}}%
  \bkPartOpener{#1}{\phTitle{\phvol}\hspace{0.8em}第#1部}{\expandafter\ph@splitname\ph@pn\@nil}{#2}%
    {\fill[white, opacity=0.16] (152,125) circle (18);
     \phfaceat{(152,125)}{12mm}{\@nameuse{ph@pface@#1}}{white}{2.4pt}}%
    {#3}%
  \bkPartContents{#1}{\input{ph\phvol-part#1}}{#4}%
  \phpartbegin{#1}}

%% ------------------------------------------------------------
%% 5. 次元チェック  \phdim{両辺の単位}   式の横に置く小さな札（文中・式の中のどちらでもよい）
%%    別行の式の右に置くとき：\pheq{式}{両辺の単位}（式はまん中、札は右はし。入らなければ札は次の行の右）
%% ------------------------------------------------------------
\newcommand\phdim[1]{\mbox{\tikz[baseline=(d.base)]\node[draw=phDim, line width=0.6pt, fill=phDimBg, rounded corners=1mm,
  inner xsep=1.2mm, inner ysep=0.7mm, font=\sffamily\footnotesize, text=bkInk] (d)
  {\raisebox{-0.1em}{\bkicon[1.05em]{phdim}{bkTheme}}\hspace{0.3em}{\bfseries\color{bkDeep}次元チェック}\hspace{0.5em}#1};}}
\newcommand\pheq[2]{\[#1\tag*{\phdim{#2}}\]}

%% ------------------------------------------------------------
%% 6. 囲み（tcolorbox）。囲みの中の小見出しは \phboxhead{見出し}（それだけで1行）
%% ------------------------------------------------------------
\def\ph@boxdeep{bkDeep}
\newcommand\phboxhead[1]{\par\addvspace{3pt}\noindent{\sffamily\bfseries\color{\ph@boxdeep}#1}\par\nobreak\vspace{1pt}\noindent\ignorespaces}
% ページをまたいで分かれたときの、2つめから先の箱の左上の札（「つづき」）
\tcbset{ph cont/.style 2 args={extras middle and last={top=4.2mm},
  overlay middle and last={\node[anchor=west, fill=#1, text=white, rounded corners=1.6mm, inner xsep=2mm, inner ysep=0.8mm,
    font=\sffamily\bfseries\footnotesize] at ([xshift=4mm]frame.north west) {#2（つづき）};}}}

% モデル化の札  \begin{phmodel}[題] \phignore{…} \phassume{…} \phlimit{…} \end{phmodel}
\newtcolorbox{phmodel}[1][]{bk labeled={phModel}{phModelBg}, unbreakable,
  title={\bkicon[1.25em]{phmodel}{phModel!70!black}\hspace{0.4\zw}モデル化の札\ifx\relax#1\relax\else\hspace{0.8\zw}{\mdseries\normalsize #1}\fi},
  before upper={\def\ph@boxdeep{phModelDeep}}}
\newcommand\ph@mrow[3]{\par\addvspace{3pt}\noindent
  \tikz[baseline=(t.base)]\node[fill=white, draw=phModel, line width=0.6pt, text=phModelDeep, rounded corners=1mm,
    font=\sffamily\bfseries\small, inner xsep=4pt, inner ysep=1.6pt] (t) {#2};\par\nobreak\vspace{1pt}%
  {\leftskip=1\zw\noindent #3\par}}
\newcommand\phignore[1]{\ph@mrow{1}{無視したこと}{#1}}
\newcommand\phassume[1]{\ph@mrow{2}{おいた仮定}{#1}}
\newcommand\phlimit[1]{\ph@mrow{3}{仮定がくずれるのは}{#1}}

% 桁の感覚  \begin{phketa}[題] … \phketaline{もの}{典型値（出典）} … \end{phketa}
\newtcolorbox{phketa}[1][]{bk labeled={phKeta}{phKetaBg}, unbreakable,
  title={\bkicon[1.25em]{phketa}{phKeta!70!black}\hspace{0.4\zw}桁の感覚\ifx\relax#1\relax\else\hspace{0.8\zw}{\mdseries\normalsize #1}\fi},
  before upper={\def\ph@boxdeep{phKetaDeep}}}
\newcommand\phketaline[2]{\par\noindent\hangindent=2\zw\hangafter=1{\color{phKeta}●}\hspace{0.4em}#1%
  \unskip\nobreak\hfil\penalty50\hskip0.6em\null\nobreak\leaders\hbox to 0.8em{\hss{\color{bkLine}・}\hss}\hfill\nobreak\hskip0.3em\hbox{#2}\par}

% 工学の駅  \phstation{この章の先の科目（カンマ区切り）}{専門書で出てくる言葉}
\newcommand\ph@stop[1]{\mbox{\tikz[baseline=-0.5ex]{\fill[white] (0,0) circle (0.42em);\draw[phInk, line width=1.1pt] (0,0) circle (0.42em);}%
  \hspace{0.3em}{\sffamily\bfseries\small #1}\hspace{0.3em}}}
\newcommand\ph@line{\mbox{\color{phInk}\rule[0.33ex]{1.2em}{1.6pt}}\hspace{0.15em}}
\newcommand\phstation[2]{%
  \begin{tcolorbox}[bk labeled={phInk}{white}, unbreakable, boxrule=0.9pt,
    title={\bkicon[1.25em]{phstation}{phInk!70!black}\hspace{0.4\zw}工学の駅},
    before upper={\def\ph@boxdeep{phInk}}]
  \phboxhead{この章の先にある工学の科目}
  {\raggedright\ph@line\foreach \s [count=\k] in {#1} {\ifnum\k>1 \ph@line\fi\ph@stop{\s}}\ph@line\hspace{0.2em}{\sffamily\footnotesize\color{bkGray}→}\par}
  \if\relax\detokenize{#2}\relax\else
  \phboxhead{専門書で出てくる言葉}
  {\small #2\par}\fi
  \end{tcolorbox}}

% この式の読み方・身近な例では・〇〇を2倍にすると？（式が出るたびに使う。左の線だけの軽い囲み。ページをまたいでよい）
\tcbset{ph bar/.style 2 args={enhanced, breakable, frame hidden, interior hidden, boxrule=0pt, arc=0pt,
  left=4.5mm, right=1mm, top=0.8mm, bottom=1.2mm, before skip=8pt, after skip=8pt,
  borderline west={2.6pt}{0pt}{#1}, coltitle=#2, fonttitle=\sffamily\bfseries,
  colbacktitle=white, titlerule=0pt, toptitle=0.4mm, bottomtitle=0.8mm, lefttitle=4.5mm}}
\newtcolorbox{phyomi}[1][]{ph bar={phYomi}{phYomiDeep},
  title={\bkicon[1.15em]{phyomi}{phYomi}\hspace{0.4\zw}この式の読み方\ifx\relax#1\relax\else\hspace{0.8\zw}{\mdseries\small #1}\fi},
