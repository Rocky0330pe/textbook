%% ------------------------------------------------------------
%% 消しゴム（第11回：全巻で同じ形にする）  \bkeraser[カバーの色]{(x,y)}{ながさ mm}{たかさ mm}
%%   左下が (x,y)。白いゴムに、紙のカバー（まん中 56％）。カバーには白い帯と細い線。
%%   ゴムのはしは少し丸く、左はしは使ってすりへった形（角が大きく丸い）。
%% ------------------------------------------------------------
\newcommand\bkeraser[4][bkBlue]{\begin{scope}[shift={#2}]
  \pgfmathsetmacro\bk@el{#3}\pgfmathsetmacro\bk@eh{#4}%
  \pgfmathsetmacro\bk@er{min(\bk@eh*0.28,2.2)}\pgfmathsetmacro\bk@es{min(\bk@eh*0.12,0.9)}%
  % ゴム（左はしはすりへって丸い）
  \filldraw[fill=white, draw=bkGray!85, line width=0.6pt]
    (\bk@er,0) -- (\bk@el-\bk@es,0) arc (-90:0:\bk@es) -- (\bk@el,\bk@eh-\bk@es) arc (0:90:\bk@es)
    -- (\bk@er,\bk@eh) arc (90:180:\bk@er) -- (0,\bk@er) arc (180:270:\bk@er) -- cycle;
  % ゴムの上の面のつや（細い線）
  \draw[bkGray!35, line width=0.5pt, line cap=round] (\bk@er+0.3,\bk@eh-0.55) -- (\bk@el*0.2-0.4,\bk@eh-0.55);
  % 紙のカバー
  \filldraw[fill=#1, draw=#1!70!black, line width=0.5pt] (\bk@el*0.22,-0.15) rectangle (\bk@el*0.78,\bk@eh+0.15);
  \fill[white] (\bk@el*0.22,\bk@eh*0.38) rectangle (\bk@el*0.78,\bk@eh*0.62);
  \draw[#1!60!black, line width=0.35pt] (\bk@el*0.22,\bk@eh*0.34) -- (\bk@el*0.78,\bk@eh*0.34)
    (\bk@el*0.22,\bk@eh*0.66) -- (\bk@el*0.78,\bk@eh*0.66);
\end{scope}}
\makeatother
\endinput
