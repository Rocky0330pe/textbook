%% luatexbase.sty -- sandbox substitute built on ltluatex (not the real CTAN package)
\ProvidesPackage{luatexbase}[2015/10/04 v1.3 substitute for sandbox]
\ifx\newluafunction\undefined\input ltluatex.tex\relax\fi
\let\luatexattributedef\attributedef
\let\luatexluaescapestring\luaescapestring
\let\luatexoutputbox\outputbox
\let\luatexlatelua\latelua
\let\luatexcatcodetable\catcodetable
\let\luatexinitcatcodetable\initcatcodetable
\let\luatexsavecatcodetable\savecatcodetable
\let\luatexluafunction\luafunction
\let\newluatexattribute\newattribute
\let\setluatexattribute\setattribute
\let\unsetluatexattribute\unsetattribute
\let\newluatexcatcodetable\newcatcodetable
\def\setluatexcatcodetable#1#2{\begingroup#2\savecatcodetable#1\endgroup}
\let\CatcodeTableIniTeX\catcodetable@initex
\let\CatcodeTableString\catcodetable@string
\let\CatcodeTableLaTeX\catcodetable@latex
\let\CatcodeTableLaTeXAtLetter\catcodetable@atletter
\newcatcodetable\CatcodeTableOther
\setluatexcatcodetable\CatcodeTableOther{\catcodetable\CatcodeTableString\catcode32=12\relax}
\newcatcodetable\CatcodeTableExpl
\setluatexcatcodetable\CatcodeTableExpl{\catcodetable\CatcodeTableLaTeX
  \catcode126=10\relax\catcode32=9\relax\catcode9=9\relax\catcode13=9\relax
  \catcode95=11\relax\catcode58=11\relax\catcode124=12\relax}
\def\SetCatcodeRange#1#2#3{\@tempcnta=#1\relax
  \loop\catcode\@tempcnta=#3\relax\ifnum\@tempcnta<#2\relax\advance\@tempcnta\@ne\repeat}
\directlua{luatexbase.catcodetables = luatexbase.catcodetables or {};
local c = luatexbase.catcodetables;
c['ini'] = \the\CatcodeTableIniTeX;
c['string'] = \the\CatcodeTableString;
c['latex'] = \the\CatcodeTableLaTeX;
c['latex-package'] = \the\CatcodeTableLaTeXAtLetter;
c['other'] = \the\CatcodeTableOther;
c['expl'] = \the\CatcodeTableExpl;
c.CatcodeTableIniTeX = c['ini']; c.CatcodeTableString = c['string'];
c.CatcodeTableLaTeX = c['latex']; c.CatcodeTableLaTeXAtLetter = c['latex-package'];
c.CatcodeTableOther = c['other']; c.CatcodeTableExpl = c['expl'];
require('luatexbase-ltjcompat');}
\endinput
